                                HorizontalLayout { spacing: 8px;
                                    EditorNavButton { horizontal-stretch: 1; editor-focus-index: 11; editor-focus-target: root.editor-focus-target; editor-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "overview"; focus-selected(index) => { root.editor-focus-target = index; } enabled: !root.confirming-remove; text: root.localize("Ejecución", "Execution"); clicked => { root.editor-page = "execution"; } }
                                    EditorNavButton { horizontal-stretch: 1; editor-focus-index: 12; editor-focus-target: root.editor-focus-target; editor-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "overview"; focus-selected(index) => { root.editor-focus-target = index; } enabled: !root.confirming-remove; text: root.localize("Actividad", "Activity"); clicked => { root.showing-editor = false; root.showing-activity = true; } }
                                }
                            }
                        }
                    }
                }
                if root.editor-page == "manual": ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        alignment: start; spacing: 12px;
                        Rectangle {
                            height: 512px; horizontal-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                            VerticalLayout {
                                x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                                Text { text: root.localize("Datos del juego", "Game details"); color: Theme.text; font-size: 15px; font-weight: 600; }
                                Text { text: root.localize("Título de la ficha", "Game title"); color: Theme.muted; }
                                edit_title_input := LibraryField { focus-on-request: root.showing-editor && root.editor-page == "manual"; navigation-focus-index: 2; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "manual"; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Título del juego", "Game title"); enabled: !root.confirming-remove; model-text <=> root.edit-title;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                Text { text: root.localize("Desarrolladores · separados por comas", "Developers · comma separated"); color: Theme.muted; }
                                edit_developers_input := LibraryField { navigation-focus-index: 3; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "manual"; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Desarrolladores", "Developers"); enabled: !root.confirming-remove; model-text <=> root.edit-developers;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                Text { text: root.localize("Distribuidores · separados por comas", "Publishers · comma separated"); color: Theme.muted; }
                                edit_publishers_input := LibraryField { navigation-focus-index: 4; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "manual"; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Distribuidores", "Publishers"); enabled: !root.confirming-remove; model-text <=> root.edit-publishers;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                Text { text: root.localize("Géneros · separados por comas", "Genres · comma separated"); color: Theme.muted; }
                                edit_genres_input := LibraryField { navigation-focus-index: 5; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "manual"; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Géneros", "Genres"); enabled: !root.confirming-remove; model-text <=> root.edit-genres;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                Text { text: root.localize("Plataformas · separadas por comas", "Platforms · comma separated"); color: Theme.muted; }
                                edit_platforms_input := LibraryField { navigation-focus-index: 6; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "manual"; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Plataformas", "Platforms"); enabled: !root.confirming-remove; model-text <=> root.edit-platforms;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                Text { text: root.localize("Lanzamiento · DD/MM/AAAA o AAAA-MM-DD", "Release date · DD/MM/YYYY or YYYY-MM-DD"); color: Theme.muted; }
                                edit_release_input := LibraryField { navigation-focus-index: 7; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "manual"; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Fecha de lanzamiento", "Release date"); enabled: !root.confirming-remove; model-text <=> root.edit-release-date;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                            }
                        }
                        Rectangle {
                            height: 156px; horizontal-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                            VerticalLayout {
                                x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                                Text { text: root.localize("Descripción", "Description"); color: Theme.text; font-size: 15px; font-weight: 600; }
                                edit_description_input := LibraryTextArea { navigation-focus-index: 8; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "manual"; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Descripción", "Description"); enabled: !root.confirming-remove; height: 100px; model-text <=> root.edit-description;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                            }
                        }
                        Rectangle {
                            height: 196px; horizontal-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                            VerticalLayout {
                                x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                                Text { text: root.localize("Sinopsis", "Synopsis"); color: Theme.text; font-size: 15px; font-weight: 600; }
                                edit_synopsis_input := LibraryTextArea { navigation-focus-index: 9; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "manual"; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Sinopsis", "Synopsis"); enabled: !root.confirming-remove; height: 140px; model-text <=> root.edit-synopsis;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                            }
                        }
                    }
                }
                if root.editor-page == "categories": ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        alignment: start; spacing: 12px;
                        Rectangle {
                            height: 130px + root.edit-category-choices.length * 52px; horizontal-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                            VerticalLayout {
                                x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                                Text { text: root.localize("Categorías del juego", "Game categories"); color: Theme.text; font-size: 15px; font-weight: 600; }
                                Text { text: root.localize("Selecciona las categorías del juego. Puedes gestionarlas en Ajustes → Categorías.", "Choose this game's categories. Manage them in Settings → Categories."); color: Theme.muted; wrap: word-wrap; }
                                if root.edit-category-choices.length == 0: Text { text: root.localize("No hay categorías disponibles.", "No categories are available."); color: Theme.muted; }
                                for category[index] in root.edit-category-choices: EditorNavCheckBox {
                                    editor-focus-index: index + 2; editor-focus-target: root.editor-focus-target; editor-focus-serial: root.editor-focus-serial;
                                    navigation-active: root.showing-editor && root.editor-page == "categories";
                                    focus-selected(index) => { root.editor-focus-target = index; }
                                    height: 44px;
                                    enabled: !root.confirming-remove;
                                    text: category.name;
                                    checked: category.checked;
                                    toggled => { root.edit-category-toggled(index, self.checked); }
                                }
                            }
                        }
                    }
                }
                if root.editor-page == "execution": ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        alignment: start; spacing: 12px;
                        if root.edit-is-local: Rectangle {
                            height: 360px; horizontal-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                            VerticalLayout {
                                x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                                Text { text: root.localize("Ejecución del juego", "Game launch settings"); color: Theme.text; font-size: 15px; font-weight: 600; }
                                Text { text: root.localize("Nombre del juego", "Game title"); color: Theme.muted; }
                                edit_local_title_input := LibraryField { focus-on-request: root.showing-editor && root.editor-page == "execution" && root.edit-is-local; navigation-focus-index: 2; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "execution" && root.edit-is-local; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Nombre del juego", "Game title"); enabled: !root.confirming-remove; model-text <=> root.edit-title;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                Text { text: root.localize("Ejecutable .sh o .AppImage · ruta completa", "Executable .sh or .AppImage · full path"); color: Theme.muted; }
                                edit_path_input := LibraryField { navigation-focus-index: 3; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "execution" && root.edit-is-local; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Ejecutable local", "Local executable"); enabled: !root.confirming-remove; model-text <=> root.edit-path;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                Text { text: root.localize("Argumentos", "Arguments"); color: Theme.muted; }
                                edit_arguments_input := LibraryField { navigation-focus-index: 4; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "execution" && root.edit-is-local; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Argumentos", "Arguments"); enabled: !root.confirming-remove; model-text <=> root.edit-arguments;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                Text { text: root.localize("Directorio de trabajo · vacío para usar el del juego", "Working directory · leave empty to use the game's directory"); color: Theme.muted; }
                                edit_cwd_input := LibraryField { navigation-focus-index: 5; navigation-focus-target: root.editor-focus-target; navigation-focus-serial: root.editor-focus-serial; navigation-active: root.showing-editor && root.editor-page == "execution" && root.edit-is-local; focus-selected(index) => { root.editor-focus-target = index; } accessible-label: root.localize("Directorio de trabajo", "Working directory"); enabled: !root.confirming-remove; model-text <=> root.edit-cwd;  changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                            }
                        }
                        if !root.edit-is-local: Rectangle {
                            height: 108px; horizontal-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                            VerticalLayout {
                                x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                                Text { text: root.localize("Ejecución del juego", "Game launch settings"); color: Theme.text; font-size: 15px; font-weight: 600; }
                                Text { text: root.localize("Steam y Faugus conservan su configuración de ejecución en sus aplicaciones.", "Steam and Faugus keep their launch settings in their own applications."); color: Theme.muted; wrap: word-wrap; }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: root.save-message != "" ? root.save-message : root.localize("Los cambios se guardan automáticamente.", "Changes save automatically."); color: Theme.muted; horizontal-stretch: 1; vertical-alignment: center; }
                    if root.editor-page != "overview": EditorNavButton {
                        width: 112px; content-padding: 12px;
                        editor-focus-index: root.editor-page == "manual" ? 10 : root.editor-page == "categories" ? root.edit-category-choices.length + 2 : 6;
                        editor-focus-target: root.editor-focus-target; editor-focus-serial: root.editor-focus-serial;
                        navigation-active: root.showing-editor && root.editor-page != "overview";
                        focus-selected(index) => { root.editor-focus-target = index; }
                        enabled: !root.confirming-remove; text: root.localize("Volver", "Back"); clicked => { root.editor-page = "overview"; }
                    }
                    if root.editor-page == "overview": EditorNavButton {
                        width: 168px; content-padding: 16px;
                        editor-focus-index: 13; editor-focus-target: root.editor-focus-target; editor-focus-serial: root.editor-focus-serial;
                        navigation-active: root.showing-editor && root.editor-page == "overview";
                        focus-selected(index) => { root.editor-focus-target = index; }
                        enabled: !root.confirming-remove; text: root.localize("Cerrar", "Close"); clicked => { root.cancel-edit(); }
                    }
                }
            }
            if root.confirming-remove: TouchArea { width: parent.width; height: parent.height; }
            if root.confirming-remove: Rectangle {
                x: parent.width * 0.2; y: parent.height * 0.3; width: parent.width * 0.6; height: 180px;
                background: #362321; border-radius: 14px; border-color: #e6a18e; border-width: 2px;
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    Text { text: root.localize("¿Quitar este juego de la biblioteca?", "Remove this game from your library?"); color: Theme.text; font-size: 20px; horizontal-alignment: center; }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        DockButton { property <int> focus-index: root.remove-focus-index; init => { self.focus(); } changed focus-index => { if self.focus-index == 0 { self.focus(); } } changed has-focus => { if self.has-focus { root.remove-focus-index = 0; } } text: root.localize("Cancelar", "Cancel"); clicked => { root.confirming-remove = false; } }
                        DockButton { property <int> focus-index: root.remove-focus-index; danger: true; changed focus-index => { if self.focus-index == 1 { self.focus(); } } changed has-focus => { if self.has-focus { root.remove-focus-index = 1; } } text: root.localize("Quitar juego", "Remove game"); clicked => { root.remove-game(); } }
                    }
                }
            }
        }

        if root.showing-artwork: Rectangle {
            vertical-stretch: 1; background: Theme.surface; border-radius: 0px;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    EditorNavButton {
                        width: 36px; height: 36px; editor-focus-index: 0;
                        editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial;
                        navigation-active: root.showing-artwork;
                        focus-selected(index) => { root.artwork-navigation-target = index; }
                        text: "←"; accessible-label: root.localize("Volver", "Back"); clicked => { root.back(); }
                    }
                    Text {
                        text: root.picking-category-icon ? root.localize("Icono de categoría", "Category icon")
                            : root.artwork-provider == "wikidata" || root.artwork-provider == "steam-metadata" ? root.localize("Buscar ficha del juego", "Search game details")
                            : root.artwork-field == "cover" ? root.localize("Elegir carátula", "Choose cover")
                            : root.artwork-field == "square_cover" ? root.localize("Elegir carátula 1:1", "Choose square cover")
                            : root.artwork-field == "logo" ? root.localize("Elegir logo", "Choose logo")
                            : root.artwork-field == "banner" ? root.localize("Elegir banner", "Choose banner")
                            : root.localize("Elegir segundo fondo", "Choose secondary background");
                        color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1;
                    }
                }
                if !root.picking-category-icon: Text { text: root.localize("Selecciona campo, proveedor y juego. Las credenciales se leen de Ajustes.", "Choose a field, provider and game. Credentials are read from Settings."); color: Theme.muted; }
                if !root.artwork-browsing: Rectangle {
                    height: root.picking-category-icon ? 98px : 150px;
                    horizontal-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                    VerticalLayout {
                        x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                        Text { text: root.localize("Imagen local o URL", "Local image or URL"); color: Theme.text; font-size: 15px; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 8px;
                            artwork_location_input := LibraryField {
                                navigation-focus-index: 2; navigation-focus-target: root.artwork-navigation-target;
                                navigation-focus-serial: root.artwork-navigation-serial; navigation-active: root.showing-artwork && !root.artwork-browsing;
                                focus-selected(index) => { root.artwork-navigation-target = index; }
                                horizontal-stretch: 1;
                                enabled: !root.artwork-importing;
                                model-text <=> root.artwork-location;
                                placeholder-text: root.localize("Ruta local o URL directa de imagen", "Local image path or direct image URL");
                                changed has-focus => { if self.has-focus { root.text-input-focused = true; } }

                            }
                            EditorNavButton {
                                editor-focus-index: 3; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial;
                                navigation-active: root.showing-artwork && !root.artwork-browsing; focus-selected(index) => { root.artwork-navigation-target = index; }
                                text: root.localize("Explorar…", "Browse…"); enabled: !root.artwork-importing;
                                clicked => {
                                    root.artwork-browsing = true;
                                    root.artwork-browser-toolbar-focus-index = 3;
                                    root.artwork-browser-toolbar-focus-serial += 1;
                                    let folder = root.artwork-pictures != "" ? root.artwork-pictures : root.artwork-home;
                                    root.browse-artwork-folder(folder);
                                }
                            }
                            EditorNavButton {
                                editor-focus-index: 4; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial;
                                navigation-active: root.showing-artwork && !root.artwork-browsing; focus-selected(index) => { root.artwork-navigation-target = index; }
                                text: root.artwork-importing ? root.localize("Cargando…", "Importing…") : root.localize("Usar imagen", "Use image");
                                enabled: !root.artwork-importing && root.artwork-location != ""; clicked => { root.import-artwork(); }
                            }
                        }
                        if !root.picking-category-icon: HorizontalLayout {
                            spacing: 8px;
                            EditorNavButton {
                                editor-focus-index: 5; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial;
                                navigation-active: root.showing-artwork && !root.artwork-browsing; focus-selected(index) => { root.artwork-navigation-target = index; }
                                horizontal-stretch: 1;
                                text: root.localize("Retirar imagen", "Remove artwork");
                                enabled: !root.artwork-importing && root.edit-artwork-path(root.artwork-field) != "";
                                clicked => { root.clear-artwork(root.artwork-field); }
                            }
                            EditorNavButton {
                                editor-focus-index: 6; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial;
                                navigation-active: root.showing-artwork && !root.artwork-browsing; focus-selected(index) => { root.artwork-navigation-target = index; }
                                horizontal-stretch: 1;
                                text: root.localize("Intercambiar fondos", "Swap backgrounds");
                                visible: root.edit-banner != "" && root.edit-secondary-background != "";
                                enabled: !root.artwork-importing && self.visible;
                                clicked => { root.swap-edit-backgrounds(); }
                            }
                        }
                    }
                }
                if root.artwork-browsing: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        artwork_browser_up_button := DockButton {
                            property <int> focus-serial: root.artwork-browser-toolbar-focus-serial;
                            text: root.localize("Subir", "Up");
                            enabled: root.artwork-parent-folder != "";
                            init => { if root.artwork-browser-toolbar-focus-index == 3 { self.focus(); } }
                            changed focus-serial => { if root.artwork-browser-toolbar-focus-index == 3 { self.focus(); } }
                            changed has-focus => { if self.has-focus { root.artwork-browser-toolbar-focus-index = 3; } }
                            clicked => { root.browse-artwork-folder(root.artwork-parent-folder); }
                        }
                        Text { text: root.artwork-folder; color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        artwork_browser_return_button := DockButton {
                            property <int> focus-serial: root.artwork-browser-toolbar-focus-serial;
                            text: root.picking-category-icon ? root.localize("Volver a categorías", "Back to categories") : root.localize("Volver a búsqueda", "Back to search");
                            init => { if root.artwork-browser-toolbar-focus-index == 4 { self.focus(); } }
                            changed focus-serial => { if root.artwork-browser-toolbar-focus-index == 4 { self.focus(); } }
                            changed has-focus => { if self.has-focus { root.artwork-browser-toolbar-focus-index = 4; } }
                            clicked => {
                                root.close-artwork-browser();
                                root.artwork-navigation-target = 9;
                                root.artwork-navigation-serial += 1;
                            }
                        }
                    }
                    Text {
                        text: root.artwork-browser-item-count + (root.english-ui ? " items · PNG, JPEG, WebP" : " elementos · PNG, JPEG, WebP");
                        color: Theme.muted;
                        font-size: 12px;
                    }
                    Text {
                        visible: root.artwork-browser-item-count == 0 && root.save-message == "";
                        text: root.localize("No hay imágenes compatibles en esta carpeta.", "No compatible images in this folder.");
                        color: Theme.muted;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;
                        Rectangle {
                            width: root.width < 800px ? 106px : 150px;
                            vertical-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                            VerticalLayout {
                                x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 10px; spacing: 8px;
                                Text { text: root.localize("LUGARES", "PLACES"); color: Theme.muted; font-size: 12px; }
                                artwork_browser_home_button := DockButton {
                                property <int> focus-serial: root.artwork-browser-toolbar-focus-serial;
                                text: root.localize("Inicio", "Home");
                                checkable: true;
                                checked: root.artwork-folder == root.artwork-home;
                                init => { if root.artwork-browser-toolbar-focus-index == 0 { self.focus(); } }
                                changed focus-serial => { if root.artwork-browser-toolbar-focus-index == 0 { self.focus(); } }
                                changed has-focus => { if self.has-focus { root.artwork-browser-toolbar-focus-index = 0; } }
                                clicked => { root.browse-artwork-folder(root.artwork-home); }
                            }
                                artwork_browser_pictures_button := DockButton {
                                property <int> focus-serial: root.artwork-browser-toolbar-focus-serial;
                                visible: root.artwork-pictures != "";
                                text: root.localize("Imágenes", "Pictures");
                                checkable: true;
                                checked: root.artwork-folder == root.artwork-pictures;
                                init => { if root.artwork-browser-toolbar-focus-index == 1 { self.focus(); } }
                                changed focus-serial => { if root.artwork-browser-toolbar-focus-index == 1 { self.focus(); } }
                                changed has-focus => { if self.has-focus { root.artwork-browser-toolbar-focus-index = 1; } }
                                clicked => { root.browse-artwork-folder(root.artwork-pictures); }
                            }
                                artwork_browser_downloads_button := DockButton {
                                property <int> focus-serial: root.artwork-browser-toolbar-focus-serial;
                                visible: root.artwork-downloads != "";
                                text: root.localize("Descargas", "Downloads");
                                checkable: true;
                                checked: root.artwork-folder == root.artwork-downloads;
                                init => { if root.artwork-browser-toolbar-focus-index == 2 { self.focus(); } }
                                changed focus-serial => { if root.artwork-browser-toolbar-focus-index == 2 { self.focus(); } }
                                changed has-focus => { if self.has-focus { root.artwork-browser-toolbar-focus-index = 2; } }
                                clicked => { root.browse-artwork-folder(root.artwork-downloads); }
                            }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                        }
                        artwork_browser_grid := ListView {
                            horizontal-stretch: 3;
                            property <int> columns: self.width >= 570px ? 3 : 2;
                            property <length> row-height: min(180px, self.width / columns * 0.75 + 32px);
                            init => { root.artwork-browser-columns-changed(self.columns); }
                            changed columns => { root.artwork-browser-columns-changed(self.columns); }
                            for row[row-index] in root.artwork-browser-rows: HorizontalLayout {
                                spacing: 8px;
                                height: artwork_browser_grid.row-height;
                                for item[column-index] in row.items: DockButton {
                                    property <int> item-index: row-index * root.artwork-browser-columns + column-index;
                                    property <int> focus-serial: root.artwork-browser-focus-serial;
                                    horizontal-stretch: 1;
                                    height: parent.height - 8px;
                                    text: (item.path == root.artwork-browser-selected-path ? "✓  " : "") + (item.directory ? "📁  " : "") + item.name;
                                    icon: item.preview;
                                    icon-size: 96px;
                                    enabled: item.path != "";
                                    init => {
                                        if root.artwork-browser-focus-index == self.item-index { self.focus(); }
                                        if !item.directory && item.path != "" && !item.preview-loaded && !item.preview-requested { root.request-artwork-preview(self.item-index, item.path); }
                                    }
                                    changed focus-serial => { if root.artwork-browser-focus-index == self.item-index { self.focus(); } }
                                    changed has-focus => { if self.has-focus { root.artwork-browser-toolbar-focus-index = -1; root.artwork-browser-focus-index = self.item-index; } }
                                    clicked => {
                                        if item.directory {
                                            root.browse-artwork-folder(item.path);
                                        } else {
                                            root.artwork-browser-selected-path = item.path;
                                            root.artwork-browser-selected-name = item.name;
                                            root.request-artwork-detail(item.path);
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 2;
                            background: Theme.base;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.text.with-alpha(0.18);
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Image {
                                    vertical-stretch: 1;
                                    source: root.artwork-browser-selected-preview;
                                    image-fit: contain;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.artwork-browser-selected-name != "" ? root.artwork-browser-selected-name : root.localize("Selecciona una imagen", "Select an image");
                                    color: Theme.text;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    visible: root.artwork-browser-selected-info != "";
                                    text: root.artwork-browser-selected-info;
                                    color: Theme.muted;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    visible: root.artwork-browser-selected-error != "";
                                    text: root.artwork-browser-selected-error;
                                    color: Theme.muted;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.artwork-browser-selected-path; color: Theme.muted; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                        artwork_browser_use_button := DockButton {
                            property <int> focus-serial: root.artwork-browser-toolbar-focus-serial;
                            text: root.artwork-importing ? root.localize("Cargando…", "Importing…") : root.localize("Usar imagen", "Use image");
                            enabled: !root.artwork-importing && root.artwork-browser-selected-valid;
                            init => { if root.artwork-browser-toolbar-focus-index == 5 { self.focus(); } }
                            changed focus-serial => { if root.artwork-browser-toolbar-focus-index == 5 { self.focus(); } }
                            changed has-focus => { if self.has-focus { root.artwork-browser-toolbar-focus-index = 5; } }
                            clicked => { root.artwork-location = root.artwork-browser-selected-path; root.import-artwork(); }
                        }
                    }
                }
                if !root.artwork-browsing: VerticalLayout {
                    vertical-stretch: 1; spacing: 12px;
                    Rectangle {
                        height: artwork-source-content.preferred-height + 28px; horizontal-stretch: 1; background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                        artwork-source-content := VerticalLayout {
                            x: 0px; y: 0px; width: parent.width; padding: 14px; spacing: 8px;
                            Text { text: root.localize("Fuente y búsqueda", "Source and search"); color: Theme.text; font-size: 15px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 12px; alignment: start;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: root.localize("Campo de imagen", "Artwork field"); color: Theme.text; font-weight: 600; }
                                    RadioOptions {
                                        editor-focus-index: 7; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial;
                                        navigation-active: root.showing-artwork && !root.artwork-browsing; focus-selected(index) => { root.artwork-navigation-target = index; }
                                        options: [root.artwork-field-label("cover"), root.artwork-field-label("square_cover"), root.artwork-field-label("logo"), root.artwork-field-label("banner"), root.artwork-field-label("banner_secondary")];
                                        selected-index: root.artwork-field == "square_cover" ? 1 : root.artwork-field == "logo" ? 2 : root.artwork-field == "banner" ? 3 : root.artwork-field == "banner_secondary" ? 4 : 0;
                                        selected(item, index) => { root.artwork-field = root.artwork-field-value(item); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: root.localize("Proveedor de imágenes", "Artwork provider"); color: Theme.text; font-weight: 600; }
                                    RadioOptions {
                                        editor-focus-index: 8; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial;
                                        navigation-active: root.showing-artwork && !root.artwork-browsing; focus-selected(index) => { root.artwork-navigation-target = index; }
                                        options: [root.artwork-provider-label("steamgriddb"), root.artwork-provider-label("steam"), root.artwork-provider-label("igdb"), root.artwork-provider-label("wikidata"), root.artwork-provider-label("steam-metadata")];
                                        selected-index: root.artwork-provider == "steam" ? 1 : root.artwork-provider == "igdb" ? 2 : root.artwork-provider == "wikidata" ? 3 : root.artwork-provider == "steam-metadata" ? 4 : 0;
                                        selected(item, index) => { root.artwork-provider = root.artwork-provider-value(item); }
                                    }
                                }
                                VerticalLayout {
                                    vertical-stretch: 1; alignment: center; spacing: 8px;
                                    artwork_query_input := LibraryField { focus-on-request: root.showing-artwork && !root.artwork-browsing && !root.picking-category-icon; property <int> focus-serial: root.artwork-query-focus-serial; navigation-focus-index: 9; navigation-focus-target: root.artwork-navigation-target; navigation-focus-serial: root.artwork-navigation-serial; navigation-active: root.showing-artwork && !root.artwork-browsing; focus-selected(index) => { root.artwork-navigation-target = index; } enabled: !root.artwork-importing; horizontal-stretch: 1; model-text <=> root.artwork-query; placeholder-text: root.localize("Buscar juego…", "Search games…"); changed focus-serial => { self.focus(); } changed has-focus => { if self.has-focus { root.text-input-focused = true; } } }
                                    EditorNavButton {
                                        editor-focus-index: 10; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial;
                                        navigation-active: root.showing-artwork && !root.artwork-browsing; focus-selected(index) => { root.artwork-navigation-target = index; }
                                        enabled: !root.artwork-importing;
                                        text: root.localize("Buscar", "Search");
                                        clicked => {
                                            if root.artwork-provider == "wikidata" || root.artwork-provider == "steam-metadata" { root.search-metadata(root.artwork-provider, root.artwork-query); }
                                            else { root.search-artwork(root.artwork-provider, root.artwork-query, root.artwork-field); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        GridLayout {
                            width: parent.width;
                            spacing: 12px;
                            for item[index] in root.artwork-results: FocusScope {
                                property <int> item-index: index;
                                property <int> focus-serial: root.artwork-results-focus-serial;
                                row: Math.floor(index / root.artwork-result-columns);
                                col: Math.mod(index, root.artwork-result-columns);
                                horizontal-stretch: 1;
                                height: item.game-choice ? 56px : root.artwork-result-columns == 1 ? 80px : 238px;
                                init => { if root.artwork-results-focus-index == self.item-index { self.focus(); } }
                                changed focus-serial => { if root.artwork-results-focus-index == self.item-index { self.focus(); } }
                                changed has-focus => { if self.has-focus { root.artwork-results-focus-index = self.item-index; } }
                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    background: root.artwork-results-focus-index == parent.item-index ? Theme.accent.with-alpha(0.14) : Theme.surface;
                                    border-radius: 8px;
                                    border-width: root.artwork-results-focus-index == parent.item-index ? 2px : 1px;
                                    border-color: root.artwork-results-focus-index == parent.item-index ? Theme.accent : Theme.text.with-alpha(0.12);
                                    clip: true;
                                }
                                VerticalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    padding: 8px;
                                    spacing: 8px;
                                    if item.preview.width > 0: Image { horizontal-stretch: 1; vertical-stretch: 1; source: item.preview; image-fit: contain; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: item.name;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => {
                                        parent.focus();
                                        root.artwork-results-focus-index = parent.item-index;
                                        if item.game-choice { root.choose-artwork(index); }
                                        else if root.artwork-provider == "wikidata" || root.artwork-provider == "steam-metadata" { root.choose-metadata(index); }
                                        else { root.choose-artwork(index); }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;
                    Text { text: root.save-message != "" ? root.save-message : root.localize("Los cambios se guardan automáticamente.", "Changes save automatically."); color: Theme.muted; horizontal-stretch: 1; vertical-alignment: center; }
                    EditorNavButton { width: 152px; content-padding: 16px; editor-focus-index: 11; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial; navigation-active: root.showing-artwork; focus-selected(index) => { root.artwork-navigation-target = index; } enabled: !root.artwork-importing; text: root.localize("Volver al editor", "Back to editor"); clicked => { root.showing-artwork = false; root.showing-editor = true; } }
                }
            }
            EditorNavButton { x: parent.width - 56px; y: 20px; width: 36px; height: 36px; editor-focus-index: 1; editor-focus-target: root.artwork-navigation-target; editor-focus-serial: root.artwork-navigation-serial; navigation-active: root.showing-artwork; focus-selected(index) => { root.artwork-navigation-target = index; } text: "×"; accessible-label: root.localize("Cerrar", "Close"); clicked => { root.cancel-edit(); } }
        }

        if root.showing-activity: Rectangle {
            vertical-stretch: 1; background: Theme.surface; border-radius: 0px;
            EditorNavButton { x: 20px; y: 20px; width: 36px; height: 36px; editor-focus-index: 0; editor-focus-target: root.activity-focus-target; editor-focus-serial: root.activity-focus-serial; navigation-active: root.showing-activity; focus-selected(index) => { root.activity-focus-target = index; } text: "←"; accessible-label: root.localize("Volver", "Back"); clicked => { root.back(); } }
            Text { x: 72px; y: 20px; width: parent.width - 156px; height: 36px; text: root.localize("Actividad", "Activity"); color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; }
            if root.games.length > 0: Rectangle {
                x: 20px; y: 72px; width: parent.width - 40px; height: 96px;
                background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                VerticalLayout {
                    x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                    Text { text: root.localize("Resumen de actividad", "Activity summary"); color: Theme.text; font-size: 15px; font-weight: 600; }
                    Text { horizontal-stretch: 1; text: root.games[root.selected-index].activity; color: Theme.muted; wrap: word-wrap; }
                }
            }
            if root.show-session-history && root.games.length > 0 && root.games[root.selected-index].activity-history != "": Rectangle {
                x: 20px; y: 180px; width: parent.width - 40px; height: max(1px, parent.height - 200px);
                background: Theme.button; border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                VerticalLayout {
                    x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 14px; spacing: 8px;
                    Text { text: root.localize("Historial de partidas", "Session history"); color: Theme.text; font-size: 15px; font-weight: 600; }
                    ScrollView {
                        vertical-stretch: 1; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        VerticalLayout {
                            width: parent.width;
                            Text { width: parent.width; text: root.games[root.selected-index].activity-history; color: Theme.muted; wrap: word-wrap; }
                        }
                    }
                }
            }
            EditorNavButton { x: parent.width - 56px; y: 20px; width: 36px; height: 36px; editor-focus-index: 1; editor-focus-target: root.activity-focus-target; editor-focus-serial: root.activity-focus-serial; navigation-active: root.showing-activity; focus-selected(index) => { root.activity-focus-target = index; } text: "×"; accessible-label: root.localize("Cerrar", "Close"); clicked => { root.cancel-edit(); } }
        }

        if root.showing-add-game: Rectangle {
            vertical-stretch: 1; background: Theme.surface; border-radius: 14px;
            VerticalLayout {
                padding: 28px; spacing: 12px;
                Text { text: root.localize("Añadir juego local", "Add local game"); color: Theme.text; font-size: 28px; font-weight: 700; }
                Text { text: root.localize("Nombre", "Name"); color: Theme.muted; }
                new_title_input := LibraryField { accessible-label: root.localize("Nombre del juego", "Game name"); model-text <=> root.new-title;  changed has-focus => { if root.showing-add-game { root.text-input-focused = self.has-focus; } } }
                Text { text: root.localize("Archivo .sh o .AppImage", ".sh or .AppImage file"); color: Theme.muted; }
                new_path_input := LibraryField { accessible-label: root.localize("Ejecutable local", "Local executable"); model-text <=> root.new-path;  changed has-focus => { if root.showing-add-game { root.text-input-focused = self.has-focus; } } }
                Text { text: root.localize("Argumentos", "Arguments"); color: Theme.muted; }
                new_arguments_input := LibraryField { accessible-label: root.localize("Argumentos", "Arguments"); model-text <=> root.new-arguments;  changed has-focus => { if root.showing-add-game { root.text-input-focused = self.has-focus; } } }
                Text { text: root.localize("Directorio de trabajo (opcional)", "Working directory (optional)"); color: Theme.muted; }
                new_cwd_input := LibraryField { accessible-label: root.localize("Directorio de trabajo", "Working directory"); model-text <=> root.new-cwd;  changed has-focus => { if root.showing-add-game { root.text-input-focused = self.has-focus; } } }
                HorizontalLayout {
                    Text { text: root.save-message; color: Theme.muted; horizontal-stretch: 1; vertical-alignment: center; }
                    DockButton { text: root.localize("Añadir", "Add"); clicked => { root.add-game(); } }
                }
            }
        }

        if root.showing-settings: Rectangle {
            vertical-stretch: 1;
            background: Theme.window;
            border-radius: 24px;
            border-width: 1px;
            border-color: Theme.text.with-alpha(0.08);
            Rectangle {
                x: 0px; y: 2px; width: parent.width; height: parent.height;
                background: #0000002e; border-radius: 24px; z: -1;
            }
            Text { x: 24px; y: 20px; width: parent.width - 48px; height: 34px; text: root.localize("Ajustes de Estante", "Estante settings"); color: Theme.text; font-size: 26px; font-weight: 700; }
                HorizontalLayout {
                    x: 24px; y: 72px; width: parent.width - 48px; height: max(120px, parent.height - 144px);
                    spacing: 0px; padding-left: 8px; padding-top: 19px;
                    VerticalLayout {
                        width: min(180px, root.width * 0.19); vertical-stretch: 1; spacing: 8px; alignment: start;
                        for page[i] in [0, 3, 2, 1, 4]: DockButton {
                            private property <bool> active-page: root.settings-section == page;
                            private property <int> focus-request: root.settings-sidebar-focus-request;
                            init => { if self.active-page { self.focus(); } }
                            changed active-page => { if self.active-page { self.focus(); } }
                            changed focus-request => { if self.active-page { self.focus(); } }
                            changed has-focus => {
                                if self.has-focus { root.settings-sidebar-focused = true; root.settings-focus-target = -1; }
                                else if self.active-page { root.settings-sidebar-focused = false; }
                            }
                            height: 40px; border-radius: 20px; button-radius: 20px; plain: true;
                            text: [root.localize("Globales", "General"), root.localize("Escaneo y scraping", "Scanning and scraping"), root.localize("Categorías", "Categories"), root.localize("Lista", "List"), root.localize("Cuadrícula", "Grid")][i];
                            background: root.settings-section == page ? Theme.accent : Theme.button;
                            foreground: root.settings-section == page ? Theme.accent-foreground : Theme.text;
                            clicked => { root.settings-section = page; settings-scroll.content-y = 0px; }
                        }
                        Text { text: root.localize("APLICACIONES", "APPLICATIONS"); color: Theme.muted; font-size: 11px; }
                        for name[i] in root.launcher-names: DockButton {
                            height: 36px;
                            private property <string> state: root.launcher-states[i];
                            changed has-focus => { if self.has-focus { root.settings-focus-target = -1; } }
                            text: self.state == "checking" || self.state == "opening" || self.state == "closing" ? name + " · " + root.launcher-status(self.state) : (self.state == "open" ? root.localize("Cerrar ", "Close ") : root.localize("Abrir ", "Open ")) + name;
                            enabled: !root.import-scanning && !root.game-session-active && self.state != "checking" && self.state != "opening" && self.state != "closing";
                            clicked => { root.operate-launcher(i); }
                        }
                    }
                    Rectangle { width: 36px; }
                    Rectangle { width: 1px; background: Theme.text.with-alpha(0.12); }
                    Rectangle { width: 28px; }
                    VerticalLayout {
                        horizontal-stretch: 1; vertical-stretch: 1;
                    settings-scroll := ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        alignment: start; spacing: 10px;
                if root.settings-section == 3: VerticalLayout {
                    alignment: start; spacing: 10px;
                    for label[i] in ["Faugus", "Heroic", "RecompLauncher", "Steam", root.localize("Todos los lanzadores", "All launchers"), root.localize("Restaurar juegos excluidos", "Restore excluded games")]: DockButton {
                        private property <int> focus-request: root.settings-content-focus-request;
                        changed focus-request => { if i == 0 { self.focus(); } }
                        changed has-focus => { if self.has-focus { root.settings-focus-target = -2; } }
                        text: i < 4 ? root.localize("Importar juegos de ", "Import games from ") + label : label;
                        enabled: !root.import-scanning && !root.game-session-active;
                        clicked => { root.scan-imports(["faugus", "heroic", "recomp", "steam", "all", "restore"][i]); }
                    }
                    replace-art := CheckBox { text: root.localize("Reemplazar imágenes y metadatos existentes", "Replace existing artwork and metadata"); }
                    HorizontalLayout {
                        scrape-cover := CheckBox { text: root.localize("Vertical", "Portrait"); checked: true; }
                        scrape-square := CheckBox { text: root.localize("Cuadrada", "Square"); checked: true; }
                        scrape-logo := CheckBox { text: "Logo"; checked: true; }
                    }
                    HorizontalLayout {
                        scrape-banner := CheckBox { text: root.localize("Fondo", "Background"); checked: true; }
                        scrape-second := CheckBox { text: root.localize("Segundo fondo", "Second background"); checked: true; }
                        scrape-info := CheckBox { text: root.localize("Ficha", "Metadata"); checked: true; }
                    }
                    DockButton {
                        text: root.localize("Scraping de la biblioteca", "Scrape library");
                        enabled: !root.import-scanning && !root.game-session-active && (scrape-cover.checked || scrape-square.checked || scrape-logo.checked || scrape-banner.checked || scrape-second.checked || scrape-info.checked);
                        clicked => { root.scrape-library(replace-art.checked, [scrape-cover.checked, scrape-square.checked, scrape-logo.checked, scrape-banner.checked, scrape-second.checked], scrape-info.checked); }
                    }
                    Text { text: root.localize("Los juegos ocultos de Faugus se ignoran. Las imágenes usan SteamGridDB si hay una clave configurada; las fichas se obtienen de Wikidata.", "Hidden Faugus games are ignored. Artwork uses SteamGridDB when a key is configured; metadata comes from Wikidata."); color: Theme.muted; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 12px;
                        scan-steamgriddb-group := SettingGroup {
                            horizontal-stretch: 1;
                            navigation-column: 0; navigation-index: 0; navigation-enabled: root.showing-settings && root.settings-section == 3; navigation-focus-children: false;
                            navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                            spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                            spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                            header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                            title: "SteamGridDB";
                            steamgriddb_key_input := LibraryField { accessible-label: root.localize("Clave SteamGridDB", "SteamGridDB key"); model-text <=> root.steamgriddb-key; input-type: password; changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                        }
                        scan-igdb-group := SettingGroup {
                            horizontal-stretch: 1;
                            navigation-column: 1; navigation-index: 1; navigation-enabled: root.showing-settings && root.settings-section == 3; navigation-focus-children: false;
                            navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                            spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                            spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                            header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                            title: root.localize("IGDB · fondos 16:9", "IGDB · 16:9 artwork");
                            igdb_client_id_input := LibraryField { accessible-label: "IGDB Client ID"; placeholder-text: "Client ID"; model-text <=> root.igdb-client-id; changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                            igdb_client_secret_input := LibraryField { accessible-label: "IGDB Client Secret"; placeholder-text: "Client Secret"; model-text <=> root.igdb-client-secret; input-type: password; changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                        }
                    }
                }
                if root.settings-section == 0: VerticalLayout {
                    alignment: start; spacing: 10px;
                    Text { text: root.localize("Ajustes globales", "Global settings"); color: Theme.text; font-size: 24px; font-weight: 700; }
                    Text { text: root.localize("Preferencias generales, controles y apariencia de la biblioteca.", "General preferences, controls and library appearance."); color: Theme.muted; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: start; spacing: 12px;
                            global-language-group := SettingGroup {
                                navigation-column: 0; navigation-index: 0; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Idioma", "Language");
                                Text { text: root.localize("El idioma se aplicará al volver a abrir Estante.", "The language applies after restarting Estante."); color: Theme.muted; wrap: word-wrap; }
                                RadioOptions {
                                    horizontal: true;
                                    options: [root.localize("Idioma del sistema", "System language"), "Español", "English"];
                                    selected-index: root.language == "es" ? 1 : root.language == "en" ? 2 : 0;
                                    selected(value, index) => { root.language = index == 1 ? "es" : index == 2 ? "en" : "system"; }
                                }
                            }
                            global-controller-group := SettingGroup {
                                navigation-column: 0; navigation-index: 1; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Tipo de mando", "Controller type");
                                RadioOptions {
                                    horizontal: true;
                                    options: ["Xbox", "Sony", "Nintendo"];
                                    selected-index: root.controller-type == "sony" ? 1 : root.controller-type == "nintendo" ? 2 : 0;
                                    selected(value, index) => { root.controller-type = index == 1 ? "sony" : index == 2 ? "nintendo" : "xbox"; }
                                }
                            }
                            global-keyboard-group := SettingGroup {
                                navigation-column: 0; navigation-index: 2; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Teclado", "Keyboard");
                                RadioOptions {
                                    options: [root.localize("Automático", "Automatic"), root.localize("Sistema", "System"), "COSMIC OSK", "KDE / Maliit", root.localize("Teclado de Estante", "Estante keyboard"), root.localize("Desactivado", "Disabled")];
                                    selected-index: root.onscreen-keyboard == "system" ? 1 : root.onscreen-keyboard == "cosmic" ? 2 : root.onscreen-keyboard == "kde" ? 3 : root.onscreen-keyboard == "builtin" ? 4 : root.onscreen-keyboard == "disabled" ? 5 : 0;
                                    selected(value, index) => { root.onscreen-keyboard = index == 1 ? "system" : index == 2 ? "cosmic" : index == 3 ? "kde" : index == 4 ? "builtin" : index == 5 ? "disabled" : "auto"; }
                                }
                                CheckBox { text: root.localize("Usar el teclado de Estante si falla el del sistema", "Use the Estante keyboard if the system keyboard is unavailable"); checked: root.keyboard-fallback; toggled => { root.keyboard-fallback = self.checked; } }
                            }
                            global-startup-group := SettingGroup {
                                navigation-column: 0; navigation-index: 3; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Inicio", "Startup");
                                CheckBox { text: root.localize("Iniciar a pantalla completa", "Start in fullscreen"); checked: root.start-fullscreen; toggled => { root.start-fullscreen = self.checked; } }
                                CheckBox { text: root.localize("Abrir Steam al iniciar Estante", "Launch Steam when Estante starts"); checked: root.start-steam-on-start; toggled => { root.start-steam-on-start = self.checked; } }
                                CheckBox { text: root.localize("Abrir Faugus al iniciar Estante", "Launch Faugus when Estante starts"); checked: root.start-faugus-on-start; toggled => { root.start-faugus-on-start = self.checked; } }
                                CheckBox { text: root.localize("Abrir Heroic al iniciar Estante", "Launch Heroic when Estante starts"); checked: root.start-heroic-on-start; toggled => { root.start-heroic-on-start = self.checked; } }
                                CheckBox { text: root.localize("Buscar actualizaciones al iniciar", "Check for updates on startup"); checked: root.check-updates-on-start; toggled => { root.check-updates-on-start = self.checked; } }
                                CheckBox { text: root.localize("Cerrar Steam al salir", "Close Steam when Estante exits"); checked: root.close-steam-on-exit; toggled => { root.close-steam-on-exit = self.checked; } }
                                CheckBox { text: root.localize("Cerrar Faugus al salir", "Close Faugus when Estante exits"); checked: root.close-faugus-on-exit; toggled => { root.close-faugus-on-exit = self.checked; } }
                                CheckBox { text: root.localize("Cerrar Heroic al salir", "Close Heroic when Estante exits"); checked: root.close-heroic-on-exit; toggled => { root.close-heroic-on-exit = self.checked; } }
                            }
                            global-playing-group := SettingGroup {
                                navigation-column: 0; navigation-index: 4; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Mientras juegas", "While playing");
                                RadioOptions {
                                    options: [root.localize("Mantener abierto", "Keep open"), root.localize("Ocultar y restaurar", "Hide and restore"), root.localize("Salvapantallas", "Screensaver"), root.localize("Bandeja del sistema", "System tray")];
                                    selected-index: root.playing-behavior == "hide" ? 1 : root.playing-behavior == "screensaver" ? 2 : root.playing-behavior == "tray" ? 3 : 0;
                                    selected(value, index) => { root.playing-behavior = index == 1 ? "hide" : index == 2 ? "screensaver" : index == 3 ? "tray" : "none"; }
                                }
                            }
                            global-screensaver-group := SettingGroup {
                                navigation-column: 0; navigation-index: 5; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Salvapantallas", "Screensaver");
                                CheckBox { text: root.localize("Activar por inactividad", "Enable after inactivity"); checked: root.screensaver-enabled; toggled => { root.screensaver-enabled = self.checked; } }
                                DockButton { text: root.localize("Vista previa", "Preview"); clicked => { root.preview-screensaver(); } }
                                HorizontalLayout {
                                    spacing: 8px; alignment: start; cross-axis-alignment: center;
                                    Text { width: 150px; text: root.localize("Inactividad", "Idle time"); color: Theme.text; vertical-alignment: center; wrap: word-wrap; }
                                    DockButton { width: 44px; height: 40px; content-padding: 4px; text: "−"; accessible-label: root.localize("Reducir tiempo de inactividad", "Decrease idle time"); clicked => { root.screensaver-idle-value = max(1, root.screensaver-idle-value - 1); } }
                                    Text { width: 40px; text: root.screensaver-idle-value; color: Theme.muted; vertical-alignment: center; horizontal-alignment: center; }
                                    DockButton { width: 44px; height: 40px; content-padding: 4px; text: "+"; accessible-label: root.localize("Aumentar tiempo de inactividad", "Increase idle time"); clicked => { root.screensaver-idle-value = min(60, root.screensaver-idle-value + 1); } }
                                    RadioOptions {
                                        horizontal-stretch: 1;
                                        horizontal: true;
                                        options: [root.localize("Segundos", "Seconds"), root.localize("Minutos", "Minutes")];
                                        selected-index: root.screensaver-idle-unit == "seconds" ? 0 : 1;
                                        selected(value, index) => { root.screensaver-idle-unit = index == 0 ? "seconds" : "minutes"; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px; alignment: start; cross-axis-alignment: center;
                                    Text { width: 150px; text: root.localize("Intervalo entre imágenes", "Image interval"); color: Theme.text; vertical-alignment: center; wrap: word-wrap; }
                                    DockButton { width: 44px; height: 40px; content-padding: 4px; text: "−"; accessible-label: root.localize("Reducir intervalo entre imágenes", "Decrease image interval"); clicked => { root.screensaver-slide-value = max(1, root.screensaver-slide-value - 1); } }
                                    Text { width: 40px; text: root.screensaver-slide-value; color: Theme.muted; vertical-alignment: center; horizontal-alignment: center; }
                                    DockButton { width: 44px; height: 40px; content-padding: 4px; text: "+"; accessible-label: root.localize("Aumentar intervalo entre imágenes", "Increase image interval"); clicked => { root.screensaver-slide-value = min(60, root.screensaver-slide-value + 1); } }
                                    RadioOptions {
                                        horizontal-stretch: 1;
                                        horizontal: true;
                                        options: [root.localize("Segundos", "Seconds"), root.localize("Minutos", "Minutes")];
                                        selected-index: root.screensaver-slide-unit == "seconds" ? 0 : 1;
                                        selected(value, index) => { root.screensaver-slide-unit = index == 0 ? "seconds" : "minutes"; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px; alignment: start; cross-axis-alignment: center;
                                    Text { width: 150px; text: root.localize("Origen", "Source"); color: Theme.text; vertical-alignment: center; }
                                    RadioOptions {
                                        horizontal-stretch: 1;
                                        horizontal: true;
                                        options: [root.localize("Juegos", "Games"), root.localize("Fondo de la aplicación", "App background")];
                                        selected-index: root.screensaver-source == "application" ? 1 : 0;
                                        selected(value, index) => { root.screensaver-source = index == 1 ? "application" : "games"; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px; alignment: start; cross-axis-alignment: center;
                                    Text { width: 150px; text: root.localize("Oscurecer", "Dim"); color: Theme.text; vertical-alignment: center; }
                                    DockButton { width: 44px; height: 40px; content-padding: 4px; text: "−"; accessible-label: root.localize("Reducir oscurecimiento", "Decrease dimming"); clicked => { root.screensaver-dim = max(0, root.screensaver-dim - 5); } }
                                    Text { width: 40px; text: root.screensaver-dim + "%"; color: Theme.muted; vertical-alignment: center; horizontal-alignment: center; }
                                    DockButton { width: 44px; height: 40px; content-padding: 4px; text: "+"; accessible-label: root.localize("Aumentar oscurecimiento", "Increase dimming"); clicked => { root.screensaver-dim = min(100, root.screensaver-dim + 5); } }
                                }
                                if root.screensaver-source == "application": VerticalLayout {
                                    spacing: 8px;
                                    Text { text: root.localize("Fondo del salvapantallas", "Screensaver background"); color: Theme.text; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        BackgroundChoice { horizontal-stretch: 1; label: root.localize("Fondo 1", "Background 1"); preview: @image-url("../../assets/backgrounds/1.png"); selected: root.screensaver-background == "bundled:1.png"; chosen => { root.screensaver-background = "bundled:1.png"; } }
                                        BackgroundChoice { horizontal-stretch: 1; label: root.localize("Fondo 2", "Background 2"); preview: @image-url("../../assets/backgrounds/2.png"); selected: root.screensaver-background == "bundled:2.png"; chosen => { root.screensaver-background = "bundled:2.png"; } }
                                        BackgroundChoice { horizontal-stretch: 1; label: root.localize("Fondo 3", "Background 3"); preview: @image-url("../../assets/backgrounds/3.png"); selected: root.screensaver-background == "bundled:3.png"; chosen => { root.screensaver-background = "bundled:3.png"; } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        BackgroundChoice { horizontal-stretch: 1; label: root.localize("Fondo 4", "Background 4"); preview: @image-url("../../assets/backgrounds/4.png"); selected: root.screensaver-background == "bundled:4.png"; chosen => { root.screensaver-background = "bundled:4.png"; } }
                                        BackgroundChoice { horizontal-stretch: 1; label: root.localize("Fondo 5", "Background 5"); preview: @image-url("../../assets/backgrounds/5.png"); selected: root.screensaver-background == "bundled:5.png"; chosen => { root.screensaver-background = "bundled:5.png"; } }
                                        BackgroundChoice { horizontal-stretch: 1; label: root.localize("Fondo 6", "Background 6"); preview: @image-url("../../assets/backgrounds/6.png"); selected: root.screensaver-background == "bundled:6.png"; chosen => { root.screensaver-background = "bundled:6.png"; } }
                                    }
                                    Text { visible: root.screensaver-background != "bundled:1.png" && root.screensaver-background != "bundled:2.png" && root.screensaver-background != "bundled:3.png" && root.screensaver-background != "bundled:4.png" && root.screensaver-background != "bundled:5.png" && root.screensaver-background != "bundled:6.png"; text: root.localize("Imagen personalizada seleccionada", "Custom image selected"); color: Theme.muted; }
                                    HorizontalLayout {
                                        Text { text: root.localize("Ruta personalizada", "Custom path"); color: Theme.text; vertical-alignment: center; }
                                        screensaver_background_input := LibraryField { accessible-label: root.localize("Ruta del fondo del salvapantallas", "Screensaver background path"); horizontal-stretch: 1; model-text <=> root.screensaver-background; changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: start; spacing: 12px;
                            global-activity-group := SettingGroup {
                                navigation-column: 1; navigation-index: 6; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Actividad", "Activity");
                                CheckBox { text: root.localize("Mostrar historial de sesiones", "Show session history"); checked: root.show-session-history; toggled => { root.show-session-history = self.checked; } }
                            }
                            global-layout-group := SettingGroup {
                                navigation-column: 1; navigation-index: 7; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Diseño de la biblioteca", "Library layout");
                                Text { text: root.localize("Presentación", "Layout"); color: Theme.text; }
                                RadioOptions {
                                    horizontal: true;
                                    options: [root.localize("Lista", "List"), root.localize("Cuadrícula", "Grid")];
                                    selected-index: root.library-layout == "grid" ? 1 : 0;
                                    selected(value, index) => { root.library-layout = index == 1 ? "grid" : "list"; root.request-settings-autosave(); }
                                }
                                Text { text: root.localize("Tema de color", "Color theme"); color: Theme.text; }
                                RadioOptions {
                                    options: [root.localize("Predeterminado", "Default"), root.localize("Combinación 176", "Combination 176"), root.localize("Combinación 143", "Combination 143")];
                                    selected-index: root.color-theme == "combination-176" ? 1 : root.color-theme == "combination-143" ? 2 : 0;
                                    selected(value, index) => { root.color-theme = index == 1 ? "combination-176" : index == 2 ? "combination-143" : "default"; }
                                }
                                CheckBox { visible: root.color-theme == "default"; text: root.localize("Tonos pastel", "Pastel colors"); checked: root.pastel-theme; toggled => { root.pastel-theme = self.checked; } }
                            }
                            global-background-source-group := SettingGroup {
                                navigation-column: 1; navigation-index: 8; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Origen del fondo", "Background source");
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: root.background-source == "global" ? root.localize("Global", "Global") : root.localize("Del juego", "Game"); color: Theme.text; vertical-alignment: center; }
                                    DockButton { text: root.localize("Cambiar origen", "Change source"); clicked => { root.background-source = root.background-source == "global" ? "game" : "global"; root.background-config-changed(root.background-split, root.blur); } }
                                    global_background_input := LibraryField { horizontal-stretch: 1; placeholder-text: root.localize("bundled:6.png o ruta", "bundled:6.png or path"); model-text <=> root.global-background; changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                                    DockButton { text: root.localize("Aplicar", "Apply"); clicked => { root.background-config-changed(root.background-split, root.blur); } }
                                }
                            }
                            global-background-fill-group := SettingGroup {
                                navigation-column: 1; navigation-index: 9; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Relleno del fondo", "Background fill");
                                DockButton { text: root.background-fill == "dominant" ? root.localize("Color dominante", "Dominant color") : root.localize("Desenfoque", "Blur"); clicked => { root.background-fill = root.background-fill == "dominant" ? "blur" : "dominant"; root.background-config-changed(root.background-split, root.blur); } }
                            }
                            global-updates-group := SettingGroup {
                                navigation-column: 1; navigation-index: 10; navigation-enabled: root.showing-settings && root.settings-section == 0; navigation-focus-children: false;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                title: root.localize("Actualizaciones", "Updates");
                                HorizontalLayout {
                                    DockButton { text: root.update-checking ? root.localize("Comprobando…", "Checking…") : root.localize("Comprobar actualizaciones", "Check for updates"); enabled: !root.update-checking && !root.update-installing; clicked => { root.check-updates(); } }
                                    DockButton { text: root.update-installing ? root.localize("Instalando…", "Installing…") : root.localize("Instalar actualización", "Install update"); visible: root.update-available && root.update-install-supported; enabled: !root.update-installing && !root.update-checking; clicked => { root.install-update(); } }
                                }
                                Text { text: root.update-status; color: Theme.muted; vertical-alignment: center; wrap: word-wrap; }
                            }
                        }
                    }
                }
                if root.settings-section == 2: VerticalLayout {
                    init => { root.refresh-members(); }
                    alignment: start; spacing: 10px;
                    Text { text: root.localize("Categorías", "Categories"); color: Theme.text; font-size: 24px; font-weight: 700; }
                    Text { text: root.localize("Gestiona juegos, orden y categoría predeterminada.", "Manage games, ordering and the default category."); color: Theme.muted; wrap: word-wrap; }
                    HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: start; spacing: 12px;
                        category-new-group := SettingGroup {
                            navigation-column: 0; navigation-index: 0; navigation-enabled: root.showing-settings && root.settings-section == 2; navigation-focus-children: false;
                            navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                            spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                            spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                            header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                            title: root.localize("Nueva categoría", "New category");
                            category_name_input := LibraryField { horizontal-stretch: 1; placeholder-text: root.localize("Nombre de la categoría", "Category name"); model-text <=> root.category-name; changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                            HorizontalLayout {
                                DockButton { text: root.localize("Añadir", "Add"); clicked => { root.manage-category("add", root.category-name, ""); } }
                                DockButton { text: root.localize("Renombrar", "Rename"); enabled: root.category-edit-index > 0; clicked => { root.manage-category("rename", root.category-name, (root.categories.length > root.category-edit-index ? root.categories[root.category-edit-index] : "")); } }
                                DockButton { text: root.confirming-category-delete ? root.localize("Confirmar eliminación", "Confirm deletion") : root.localize("Eliminar", "Delete"); enabled: root.category-edit-index > 0; clicked => { if root.confirming-category-delete { root.manage-category("delete", (root.categories.length > root.category-edit-index ? root.categories[root.category-edit-index] : ""), ""); root.confirming-category-delete = false; } else { root.confirming-category-delete = true; } } }
                            }
                        }
                        category-default-group := SettingGroup {
                            navigation-column: 0; navigation-index: 2; navigation-enabled: root.showing-settings && root.settings-section == 2; navigation-focus-children: false;
                            navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                            spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                            spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                            header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                            title: root.localize("Categoría predeterminada", "Default category");
                            RadioOptions {
                                options: root.categories;
                                selected-index: root.category-edit-index;
                                selected(value, index) => { root.category-edit-index = index; }
                            }
                            DockButton {
                                text: root.choice-label("Usar como predeterminada", "Set as default", root.managed-category == root.primary-category);
                                enabled: root.managed-category != "";
                                clicked => { root.manage-category("primary", root.managed-category, ""); }
                            }
                        }
                        category-icons-group := SettingGroup {
                            navigation-column: 0; navigation-index: 3; navigation-enabled: root.showing-settings && root.settings-section == 2; navigation-focus-children: false;
                            navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                            spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                            spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                            header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                            title: root.localize("Iconos de categorías", "Category icons");
                            Text { text: root.localize("Icono para categoría", "Icon for category"); color: Theme.muted; }
                            RadioOptions {
                                options: root.categories;
                                selected-index: root.category-edit-index;
                                selected(value, index) => { root.category-edit-index = index; }
                            }
                            Image { height: 48px; source: root.category-icons[root.category-edit-index]; image-fit: contain; }
                            LibraryField { placeholder-text: root.localize("Ruta del icono local", "Local icon path"); model-text <=> root.icon-path; changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                            HorizontalLayout {
                                DockButton { text: root.localize("Explorar…", "Browse…"); clicked => {
                                    root.picking-category-icon = true; root.showing-settings = false; root.showing-artwork = true; root.artwork-browsing = true;
                                    root.browse-artwork-folder(root.artwork-pictures != "" ? root.artwork-pictures : root.artwork-home);
                                } }
                                DockButton { text: root.localize("Usar icono local", "Use local icon"); enabled: root.icon-path != ""; clicked => { root.manage-category("icon", root.managed-category, root.icon-path); } }
                                DockButton { text: root.localize("Quitar icono", "Remove icon"); clicked => { root.manage-category("clear-icon", root.managed-category, ""); } }
                            }
                            RadioOptions {
                                horizontal: true;
                                options: ["Bootstrap Icons", "Iconify", "Simple Icons"];
                                selected-index: root.icon-provider == "iconify" ? 1 : root.icon-provider == "simpleicons" ? 2 : 0;
                                selected(value, index) => { root.icon-provider = index == 1 ? "iconify" : index == 2 ? "simpleicons" : "bootstrap"; }
                            }
                            LibraryField { placeholder-text: root.localize("Buscar icono (en inglés)", "Search icons (in English)"); model-text <=> root.icon-query; changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                            DockButton { text: root.localize("Buscar iconos", "Search icons"); enabled: !root.icon-busy && root.icon-query != ""; clicked => { root.search-icons(); } }
                            if root.icon-results.length > 0: ListView {
                                height: 200px;
                                for option[index] in root.icon-results: DockButton { text: option; enabled: !root.icon-busy; clicked => { root.choose-icon(index); } }
                            }
                        }
                    }
                    category-list-group := SettingGroup {
                        horizontal-stretch: 1;
                        navigation-column: 1; navigation-index: 1; navigation-enabled: root.showing-settings && root.settings-section == 2; navigation-focus-children: false;
                        navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                        spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                        spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                        header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                        title: root.localize("Categorías", "Categories");
                        HorizontalLayout {
                            spacing: 8px;
                            RadioOptions {
                                options: root.categories;
                                selected-index: root.category-edit-index;
                                selected(value, index) => { root.category-edit-index = index; }
                            }
                            DockButton { text: "↑"; accessible-label: root.localize("Mover categoría arriba", "Move category up"); enabled: root.category-edit-index > 1; clicked => { root.manage-category("up", (root.categories.length > root.category-edit-index ? root.categories[root.category-edit-index] : ""), ""); } }
                            DockButton { text: "↓"; accessible-label: root.localize("Mover categoría abajo", "Move category down"); enabled: root.category-edit-index > 0 && root.category-edit-index + 1 < root.categories.length; clicked => { root.manage-category("down", (root.categories.length > root.category-edit-index ? root.categories[root.category-edit-index] : ""), ""); } }
                        }
                        if root.managed-category != "": VerticalLayout {
                            spacing: 8px;
                            Text { text: root.localize("Juegos de la categoría", "Games in category"); color: Theme.muted; }
                            LibraryField { model-text <=> root.member-query; placeholder-text: root.localize("Buscar juegos…", "Search games…"); changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } } }
                            ListView {
                                height: 240px;
                                for member in root.category-members: CheckBox { text: member.title; checked: member.checked; toggled => { root.manage-category(self.checked ? "join" : "leave", root.managed-category, member.id); } }
                            }
                        }
                    }
                    }
                }
                if root.settings-section == 4: VerticalLayout {
                    spacing: 16px;
                    Text { text: root.localize("Cuadrícula", "Grid"); color: Theme.text; font-size: 24px; font-weight: 700; }
                    Text { text: root.localize("Ajustes exclusivos de la cuadrícula.", "Grid-specific appearance settings."); color: Theme.muted; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout { alignment: start; spacing: 12px; horizontal-stretch: 1; min-width: 0px; preferred-width: 1px;
                            grid-background-group := SettingGroup {
                                private property <int> focus-request: root.settings-content-focus-request;
                                changed focus-request => { if root.settings-section == 4 { self.focus-header(); } }
                                expanded: false; flat: false; horizontal-stretch: 1;
                                navigation-column: 0; navigation-index: 0; navigation-enabled: root.showing-settings && root.settings-section == 4 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focused-slider = -1; root.settings-focus-y = y; } }
                                spatial-focus-requested(index, y) => { if index == 0 { grid-dim-slider.focus-control(); } }
                                title: root.localize("Fondo", "Background");
                                grid-dim-slider := SettingStepper { label: root.localize("Oscurecimiento (%)", "Dimming (%)"); minimum: 0; maximum: 100; number <=> root.grid-dim; focus-changed(focused) => { if focused { root.settings-focused-slider = 0; root.settings-focus-target = 0; root.settings-focus-y = root.settings-row-y-0 + grid-background-group.content-origin-y + self.y + self.focus-center-y; } else if root.settings-focused-slider == 0 { root.settings-focused-slider = -1; root.settings-slider-adjusting = false; } } }
                                grid-blur-slider := SettingStepper { label: root.localize("Desenfoque (px)", "Blur (px)"); minimum: 0; maximum: 40; number <=> root.grid-blur; focus-changed(focused) => { if focused { root.settings-focused-slider = 1; root.settings-focus-target = 0; root.settings-focus-y = root.settings-row-y-0 + grid-background-group.content-origin-y + self.y + self.focus-center-y; } else if root.settings-focused-slider == 1 { root.settings-focused-slider = -1; root.settings-slider-adjusting = false; } } }
                            }
                            grid-hero-group := SettingGroup {
                                expanded: false; flat: false; horizontal-stretch: 1;
                                navigation-column: 0; navigation-index: 1; navigation-enabled: root.showing-settings && root.settings-section == 4 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                spatial-focus-requested(index, y) => { if index == 1 { grid-hero-full.focus-control(); } }
                                title: root.localize("Posición del fondo", "Background position");
                                grid-hero-full := RadioOption { option-label: root.localize("Completo", "Full"); selected: root.grid-hero-position == "full"; chosen => { root.grid-hero-position = "full"; } }
                                grid-hero-top := RadioOption { option-label: root.localize("Arriba", "Top"); selected: root.grid-hero-position == "top"; chosen => { root.grid-hero-position = "top"; } }
                                grid-hero-lower := RadioOption { option-label: root.localize("Abajo", "Lower"); selected: root.grid-hero-position == "lower"; chosen => { root.grid-hero-position = "lower"; } }
                            }
                            grid-split-group := SettingGroup {
                                expanded: false; flat: false; horizontal-stretch: 1;
                                navigation-column: 0; navigation-index: 2; navigation-enabled: root.showing-settings && root.settings-section == 4 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                spatial-focus-requested(index, y) => { if index == 2 { grid-split-single.focus-control(); } }
                                title: root.localize("División del fondo", "Background split");
                                grid-split-single := RadioOption { option-label: root.localize("Único", "Single"); selected: root.grid-background-split == "single"; chosen => { root.grid-background-split = "single"; } }
                                grid-split-horizontal := RadioOption { option-label: root.localize("Horizontal", "Horizontal"); selected: root.grid-background-split == "horizontal"; chosen => { root.grid-background-split = "horizontal"; } }
                                grid-split-vertical := RadioOption { option-label: root.localize("Vertical", "Vertical"); selected: root.grid-background-split == "vertical"; chosen => { root.grid-background-split = "vertical"; } }
                                grid-split-diagonal := RadioOption { option-label: root.localize("Diagonal", "Diagonal"); selected: root.grid-background-split == "diagonal"; chosen => { root.grid-background-split = "diagonal"; } }
                            }
                            grid-minimal-group := SettingGroup {
                                expanded: false; flat: false; horizontal-stretch: 1;
                                navigation-column: 0; navigation-index: 3; navigation-enabled: root.showing-settings && root.settings-section == 4 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                spatial-focus-requested(index, y) => { if index == 3 { grid-minimal-check.focus-control(); } }
                                title: root.localize("Presentación", "Presentation");
                                grid-minimal-check := SettingCheck { text: root.localize("Presentación mínima", "Minimal presentation"); checked <=> root.grid-minimal; }
                            }
                        }
                        VerticalLayout { alignment: start; spacing: 12px; horizontal-stretch: 1; min-width: 0px; preferred-width: 1px;
                            grid-information-group := SettingGroup {
                                expanded: false; flat: false; horizontal-stretch: 1;
                                navigation-column: 1; navigation-index: 5; navigation-enabled: root.showing-settings && root.settings-section == 4 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                spatial-focus-requested(index, y) => { if index == 5 { grid-launcher-check.focus-control(); } }
                                title: root.localize("Información del juego", "Game information");
                                grid-launcher-check := SettingCheck { text: root.localize("Datos del lanzador", "Launcher details"); checked <=> root.grid-launcher-details; }
                            }
                            grid-pagination-group := SettingGroup {
                                expanded: false; flat: false; horizontal-stretch: 1;
                                navigation-column: 1; navigation-index: 6; navigation-enabled: root.showing-settings && root.settings-section == 4 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                spatial-focus-requested(index, y) => { if index == 6 { grid-page-slider.focus-control(); } }
                                title: root.localize("Paginación", "Pagination");
                                grid-page-slider := SettingStepper { label: root.localize("Juegos por página", "Games per page"); minimum: 1; maximum: 100; number <=> root.grid-page-size; focus-changed(focused) => { if focused { root.settings-focused-slider = 10; root.settings-focus-target = 6; root.settings-focus-y = root.settings-row-y-6 + grid-pagination-group.content-origin-y + self.y + self.focus-center-y; } else if root.settings-focused-slider == 10 { root.settings-focused-slider = -1; root.settings-slider-adjusting = false; } } }
                            }
                            grid-covers-group := SettingGroup {
                                expanded: false; flat: false; horizontal-stretch: 1;
                                navigation-column: 1; navigation-index: 7; navigation-enabled: root.showing-settings && root.settings-section == 4 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                spatial-focus-requested(index, y) => { if index == 7 { grid-cover-portrait.focus-control(); } }
                                title: root.localize("Carátulas", "Covers");
                                Text { text: root.localize("Formato", "Format"); color: Theme.text; }
                                grid-cover-portrait := RadioOption { option-label: root.localize("Vertical (2:3)", "Portrait (2:3)"); selected: root.grid-cover-format == "portrait"; chosen => { root.grid-cover-format = "portrait"; } }
                                grid-cover-square := RadioOption { option-label: root.localize("Cuadrado (1:1)", "Square (1:1)"); selected: root.grid-cover-format == "square"; chosen => { root.grid-cover-format = "square"; } }
                                grid-cover-radius-slider := SettingStepper { label: root.localize("Redondeado", "Corner radius"); minimum: 0; maximum: 40; number <=> root.grid-cover-radius; focus-changed(focused) => { if focused { root.settings-focused-slider = 11; root.settings-focus-target = 7; root.settings-focus-y = root.settings-row-y-7 + grid-covers-group.content-origin-y + self.y + self.focus-center-y; } else if root.settings-focused-slider == 11 { root.settings-focused-slider = -1; root.settings-slider-adjusting = false; } } }
                                grid-zoom-slider := SettingStepper { label: root.localize("Tamaño de carátulas", "Cover size"); minimum: 50; maximum: 200; number <=> root.grid-zoom; focus-changed(focused) => { if focused { root.settings-focused-slider = 12; root.settings-focus-target = 7; root.settings-focus-y = root.settings-row-y-7 + grid-covers-group.content-origin-y + self.y + self.focus-center-y; } else if root.settings-focused-slider == 12 { root.settings-focused-slider = -1; root.settings-slider-adjusting = false; } } }
                            }
                            grid-ring-group := SettingGroup {
                                expanded: false; flat: false; horizontal-stretch: 1;
                                navigation-column: 1; navigation-index: 8; navigation-enabled: root.showing-settings && root.settings-section == 4 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                navigation-target: root.settings-focus-target; navigation-focus-y: root.settings-focus-y;
                                spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focus-y = y; } }
                                spatial-focus-requested(index, y) => { if index == 8 { grid-ring-check.focus-control(); } }
                                title: root.localize("Anillo de selección", "Selection ring");
                                grid-ring-check := SettingCheck { text: root.localize("Borde de selección", "Selection border"); checked <=> root.grid-ring-enabled; }
                                Text { text: root.localize("Color del borde", "Border color"); color: Theme.text; }
                                grid-ring-color-input := LibraryField { accessible-label: root.localize("Color del borde", "Border color"); model-text <=> root.grid-ring-color-text; updated(value) => { root.grid-ring-color-changed(value); } changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } if self.has-focus { root.settings-focused-slider = -1; root.settings-focus-target = 8; root.settings-focus-y = root.settings-row-y-8 + grid-ring-group.content-origin-y + self.y + self.height / 2; } } }
                                grid-ring-width-slider := SettingStepper { label: root.localize("Grosor del borde", "Border width"); minimum: 0; maximum: 12; number <=> root.grid-ring-width; focus-changed(focused) => { if focused { root.settings-focused-slider = 13; root.settings-focus-target = 8; root.settings-focus-y = root.settings-row-y-8 + grid-ring-group.content-origin-y + self.y + self.focus-center-y; } else if root.settings-focused-slider == 13 { root.settings-focused-slider = -1; root.settings-slider-adjusting = false; } } }
                                grid-ring-radius-slider := SettingStepper { label: root.localize("Radio del borde", "Border radius"); minimum: 0; maximum: 50; number <=> root.grid-ring-radius; focus-changed(focused) => { if focused { root.settings-focused-slider = 14; root.settings-focus-target = 8; root.settings-focus-y = root.settings-row-y-8 + grid-ring-group.content-origin-y + self.y + self.focus-center-y; } else if root.settings-focused-slider == 14 { root.settings-focused-slider = -1; root.settings-slider-adjusting = false; } } }
                            }
                        }
                    }
                }
                if root.settings-section == 1: VerticalLayout {
                    spacing: 16px;
                    Text { text: root.localize("Lista", "List"); color: Theme.text; font-size: 24px; font-weight: 700; }
                    Text { text: root.localize("Estos ajustes se aplican solo a esta apariencia.", "These settings apply only to this appearance."); color: Theme.muted; wrap: word-wrap; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: list-settings-surface.preferred-height;
                        background: transparent;
                        border-color: transparent;
                        border-width: 0px;
                        border-radius: 0px;
                        list-settings-surface := HorizontalLayout {
                            padding: 0px;
                            spacing: 16px;
                            horizontal-stretch: 1;
                            VerticalLayout { alignment: start; spacing: 12px; horizontal-stretch: 1; min-width: 0px; preferred-width: 1px;
                                list_position_group := SettingGroup { expanded: false; flat: false; horizontal-stretch: 1;
                                                    private property <int> focus-request: root.settings-content-focus-request;
                                                    changed focus-request => { self.focus-header(); }
                                                    navigation-column: 0; navigation-index: 0; navigation-enabled: root.showing-settings && root.settings-section == 1 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                                    navigation-target: root.settings-focus-target;
                                                    navigation-focus-y: root.settings-focus-y;
                                                    spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                                    spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
