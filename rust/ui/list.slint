    callback install-update();

    pure function button-icon(action: string) -> image {
        if root.controller-type == "sony" {
            return action == "play" ? @image-url("../../qt_app/assets/controller/sony/square.svg")
                : action == "edit" ? @image-url("../../qt_app/assets/controller/sony/triangle.svg")
                : action == "back" ? @image-url("../../qt_app/assets/controller/sony/circle.svg")
                : @image-url("../../qt_app/assets/controller/sony/options.svg");
        }
        if root.controller-type == "nintendo" {
            return action == "play" ? @image-url("../../qt_app/assets/controller/nintendo/Y.svg")
                : action == "edit" ? @image-url("../../qt_app/assets/controller/nintendo/X.svg")
                : action == "back" ? @image-url("../../qt_app/assets/controller/nintendo/A.svg")
                : @image-url("../../qt_app/assets/controller/nintendo/plus.svg");
        }
        return action == "play" ? @image-url("../../qt_app/assets/controller/xbox/X.svg")
            : action == "edit" ? @image-url("../../qt_app/assets/controller/xbox/Y.svg")
            : action == "back" ? @image-url("../../qt_app/assets/controller/xbox/B.svg")
            : @image-url("../../qt_app/assets/controller/xbox/menu.svg");
    }
    pure function settings-navigation-hint() -> string {
        if !root.controller-input-active {
            return root.localize("Flechas: mover · Intro: desplegar o elegir · Esc: plegar o volver · Guardado automático", "Arrow keys: move · Enter: expand or choose · Esc: collapse or back · Saves automatically");
        }
        if root.controller-type == "nintendo" {
            return root.localize("Cruceta: mover · B: desplegar o elegir · A: plegar o volver · Guardado automático", "D-pad: move · B: expand or choose · A: collapse or back · Saves automatically");
        }
        if root.controller-type == "sony" {
            return root.localize("Cruceta: mover · ✕: desplegar o elegir · ○: plegar o volver · Guardado automático", "D-pad: move · ✕: expand or choose · ○: collapse or back · Saves automatically");
        }
        return root.localize("Cruceta: mover · A: desplegar o elegir · B: plegar o volver · Guardado automático", "D-pad: move · A: expand or choose · B: collapse or back · Saves automatically");
    }
    pure function localize(spanish: string, english: string) -> string {
        return root.english-ui ? english : spanish;
    }
    pure function choice-label(spanish: string, english: string, selected: bool) -> string {
        return (selected ? "✓ " : "") + root.localize(spanish, english);
    }
    public function focus-library() {
        root.gamepad-toolbar-focus = false;
        root.text-input-focused = false;
        keyboard.focus();
    }
    public function focus-settings-sidebar() {
        root.settings-sidebar-focus-request += 1;
    }
    public function focus-settings-content() {
        if root.settings-section == 3 { root.settings-content-focus-request += 1; }
        else if root.settings-section == 1 || root.settings-section == 4 { root.settings-focus-target = 0; root.settings-content-focus-request += 1; }
        else { root.settings-focus-target = 0; }
    }
    public function clear-settings-focus-target() {
        root.settings-focus-target = -1;
    }
    public function focus-dock-entry() {
        if dock-play.enabled { dock-play.focus(); }
        else if dock-edit.enabled { dock-edit.focus(); }
        else { dock-back.focus(); }
    }
    public function update-settings-position(index: int, y: length) {
        if index == 0 { root.settings-row-y-0 = y; }
        else if index == 1 { root.settings-row-y-1 = y; }
        else if index == 2 { root.settings-row-y-2 = y; }
        else if index == 3 { root.settings-row-y-3 = y; }
        else if index == 4 { root.settings-row-y-4 = y; }
        else if index == 5 { root.settings-row-y-5 = y; }
        else if index == 6 { root.settings-row-y-6 = y; }
        else if index == 7 { root.settings-row-y-7 = y; }
        else if index == 8 { root.settings-row-y-8 = y; }
        else if index == 9 { root.settings-row-y-9 = y; }
        else if index == 10 { root.settings-row-y-10 = y; }
    }
    pure function closest-settings-row(y: length, a: length, b: length, c: length, d: length, e: length, count: int, offset: int) -> int {
        let da = abs((a - y) / 1px);
        let db = abs((b - y) / 1px);
        let dc = count > 2 ? abs((c - y) / 1px) : 1000000.0;
        let dd = count > 3 ? abs((d - y) / 1px) : 1000000.0;
        let de = count > 4 ? abs((e - y) / 1px) : 1000000.0;
        let best = min(min(da, db), min(min(dc, dd), de));
        return (da == best ? offset : db == best ? offset + 1 : dc == best ? offset + 2 : dd == best ? offset + 3 : offset + 4);
    }
    pure function closest-settings-row-seven(y: length, a: length, b: length, c: length, d: length, e: length, f: length, g: length, count: int, offset: int) -> int {
        let da = abs((a - y) / 1px);
        let db = abs((b - y) / 1px);
        let dc = count > 2 ? abs((c - y) / 1px) : 1000000.0;
        let dd = count > 3 ? abs((d - y) / 1px) : 1000000.0;
        let de = count > 4 ? abs((e - y) / 1px) : 1000000.0;
        let df = count > 5 ? abs((f - y) / 1px) : 1000000.0;
        let dg = count > 6 ? abs((g - y) / 1px) : 1000000.0;
        let best = min(min(da, db), min(min(dc, dd), min(de, min(df, dg))));
        return (da == best ? offset : db == best ? offset + 1 : dc == best ? offset + 2 : dd == best ? offset + 3 : de == best ? offset + 4 : df == best ? offset + 5 : offset + 6);
    }
    public function move-settings-focus(column: int, y: length, direction: string) {
        if (root.settings-section == 1 || root.settings-section == 4) && column == 0 && direction == "right" {
            root.settings-focus-target = root.settings-focus-target == 0 ? 5
                : root.settings-focus-target == 1 ? 6
                : root.settings-focus-target == 2 ? 7 : 8;
        } else if (root.settings-section == 1 || root.settings-section == 4) && column == 1 && direction == "left" {
            root.settings-focus-target = root.settings-focus-target == 5 ? 0
                : root.settings-focus-target == 6 ? 1
                : root.settings-focus-target == 7 ? 2 : 3;
        } else if root.settings-section == 0 && column == 0 && direction == "right" {
            root.settings-focus-target = root.closest-settings-row(y, root.settings-row-y-6, root.settings-row-y-7, root.settings-row-y-8, root.settings-row-y-9, root.settings-row-y-10, 5, 6);
        } else if root.settings-section == 0 && column == 1 && direction == "left" {
            let first = root.closest-settings-row(y, root.settings-row-y-0, root.settings-row-y-1, root.settings-row-y-2, root.settings-row-y-3, root.settings-row-y-4, 5, 0);
            let first-y = first == 0 ? root.settings-row-y-0 : first == 1 ? root.settings-row-y-1 : first == 2 ? root.settings-row-y-2 : first == 3 ? root.settings-row-y-3 : root.settings-row-y-4;
            root.settings-focus-target = abs((root.settings-row-y-5 - y) / 1px) < abs((first-y - y) / 1px) ? 5 : first;
        } else if root.settings-section == 2 && column == 0 && direction == "right" {
            root.settings-focus-target = 1;
        } else if root.settings-section == 2 && column == 1 && direction == "left" {
            let target = root.closest-settings-row(y, root.settings-row-y-0, root.settings-row-y-2, root.settings-row-y-3, 0px, 0px, 3, 0);
            root.settings-focus-target = [0, 2, 3][target];
        } else if root.settings-section == 3 && column == 0 && direction == "right" {
            root.settings-focus-target = 1;
        } else if root.settings-section == 3 && column == 1 && direction == "left" {
            root.settings-focus-target = 0;
        }
    }
    public function step-dock-focus(forward: bool) {
        let index = root.gamepad-toolbar-index;
        if forward {
            if index < 1 && dock-edit.enabled { dock-edit.focus(); }
            else if index < 2 { dock-back.focus(); }
            else if index < 3 { dock-settings.focus(); }
            else if index < 4 && dock-alphabet.enabled { dock-alphabet.focus(); }
            else if index < 5 { search_input.focus(); }
            else if index < 6 { dock-category.focus(); }
            else if index < 7 { dock-add.focus(); }
            else if index < 8 { dock-tray.focus(); }
            else if index < 9 { dock-quit.focus(); }
            else if root.list-side == "right" { root.focus-library(); }
        } else {
            if index > 8 { dock-tray.focus(); }
            else if index > 7 { dock-add.focus(); }
            else if index > 6 { dock-category.focus(); }
            else if index > 5 { search_input.focus(); }
            else if index > 4 && dock-alphabet.enabled { dock-alphabet.focus(); }
            else if index > 3 { dock-settings.focus(); }
            else if index > 2 { dock-back.focus(); }
            else if index > 1 && dock-edit.enabled { dock-edit.focus(); }
            else if index > 0 && dock-play.enabled { dock-play.focus(); }
            else if root.list-side == "left" { root.focus-library(); }
        }
    }

    function reveal-toolbar-control(control-x: length, control-width: length) {
        let left = -toolbar-scroll.content-x;
        if control-x - 8px < left { toolbar-scroll.content-x = -max(0px, control-x - 8px); }
        else if control-x + control-width + 8px > left + toolbar-scroll.visible-width {
            toolbar-scroll.content-x = -(control-x + control-width + 8px - toolbar-scroll.visible-width);
        }
    }
