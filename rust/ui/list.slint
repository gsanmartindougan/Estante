                                                            horizontal-stretch: 1; min-width: 0px; preferred-width: 1px;
                                                            list_corner_slider := SettingStepper { label: root.localize("Redondeado", "Corner radius"); minimum: 0; maximum: 40; number <=> root.cover-radius; focus-changed(focused) => { if focused { root.settings-focused-slider = 5; root.settings-focus-target = 7; root.settings-focus-y = root.settings-row-y-7 + list_covers_group.content-origin-y + self.y + self.focus-center-y; } else { if root.settings-focused-slider == 5 { root.settings-focused-slider = -1; } root.settings-slider-adjusting = false; } } }
                                                            list_cover_slider := SettingStepper { label: root.localize("Tamaño de carátula", "Cover size"); minimum: 50; maximum: 175; number <=> root.cover-zoom; focus-changed(focused) => { if focused { root.settings-focused-slider = 6; root.settings-focus-target = 7; root.settings-focus-y = root.settings-row-y-7 + list_covers_group.content-origin-y + self.y + self.focus-center-y; } else { if root.settings-focused-slider == 6 { root.settings-focused-slider = -1; } root.settings-slider-adjusting = false; } } }
                                                        }
                                                    }
                                                }
            list_ring_group := SettingGroup { expanded: false; flat: false; horizontal-stretch: 1;
                                                    navigation-column: 1; navigation-index: 8; navigation-enabled: root.showing-settings && root.settings-section == 1 && !root.settings-slider-adjusting && !root.settings-slider-focused;
                                                    navigation-target: root.settings-focus-target;
                                                    navigation-focus-y: root.settings-focus-y;
                                                    spatial-position-changed(index, y) => { root.update-settings-position(index, y); }
                                                    spatial-navigation(column, y, direction) => { root.move-settings-focus(column, y, direction); }
                                                    header-focus-changed(index, focused, y) => { if focused { root.settings-focus-target = index; root.settings-focused-slider = -1; root.settings-focus-y = y; } }
                                                    spatial-focus-requested(index, y) => {
                                                        if index == 8 {
                                                            let base = root.settings-row-y-8 + list_ring_group.content-origin-y;
                                                            let target = root.closest-settings-row(y, root.settings-row-y-8 + 32px, base + list_ring_check.y + list_ring_check.height / 2, base + ring_color_input.y + ring_color_input.height / 2, base + list_ring_width_slider.y + list_ring_width_slider.focus-center-y, base + list_ring_radius_slider.y + list_ring_radius_slider.focus-center-y, 5, 0);
                                                            if target == 0 { list_ring_group.focus-header(); } else if target == 1 { list_ring_check.focus-control(); } else if target == 2 { ring_color_input.focus(); } else if target == 3 { list_ring_width_slider.focus-control(); } else { list_ring_radius_slider.focus-control(); }
                                                        }
                                                    }
                                                    title: root.localize("Anillo de selección", "Selection ring");
                                                    HorizontalLayout {
                                                        spacing: 16px;
                                                        list_ring_check := SettingCheck {
                                                            horizontal-stretch: 1; min-width: 0px; preferred-width: 1px;
                                                            text: root.localize("Borde de selección", "Selection border");
                                                            checked <=> root.ring-enabled;
                                                            focus-changed(focused) => { if focused { root.settings-focused-slider = -1; root.settings-focus-target = 8; root.settings-focus-y = root.settings-row-y-8 + list_ring_group.content-origin-y + self.y + self.height / 2; } }
                                                        }
                                                        VerticalLayout {
                                                            horizontal-stretch: 1; min-width: 0px; preferred-width: 1px;
                                                            Text { text: root.localize("Color del borde", "Border color"); color: Theme.text; }
                                                            ring_color_input := LibraryField { accessible-label: root.localize("Color del borde", "Border color"); model-text <=> root.ring-color-text; updated(value) => { root.ring-color-changed(value); } changed has-focus => { if root.showing-settings { root.text-input-focused = self.has-focus; } if self.has-focus { root.settings-focused-slider = -1; root.settings-focus-target = 8; root.settings-focus-y = root.settings-row-y-8 + list_ring_group.content-origin-y + self.y + self.height / 2; } } }
                                                        }
                                                        list_ring_width_slider := SettingStepper { horizontal-stretch: 1; min-width: 0px; preferred-width: 1px; label: root.localize("Grosor del borde", "Border width"); minimum: 0; maximum: 12; number <=> root.ring-width; focus-changed(focused) => { if focused { root.settings-focused-slider = 7; root.settings-focus-target = 8; root.settings-focus-y = root.settings-row-y-8 + list_ring_group.content-origin-y + self.y + self.focus-center-y; } else { if root.settings-focused-slider == 7 { root.settings-focused-slider = -1; } root.settings-slider-adjusting = false; } } }
                                                        list_ring_radius_slider := SettingStepper { horizontal-stretch: 1; min-width: 0px; preferred-width: 1px; label: root.localize("Radio del borde", "Border radius"); minimum: 0; maximum: 50; number <=> root.ring-radius; focus-changed(focused) => { if focused { root.settings-focused-slider = 8; root.settings-focus-target = 8; root.settings-focus-y = root.settings-row-y-8 + list_ring_group.content-origin-y + self.y + self.focus-center-y; } else { if root.settings-focused-slider == 8 { root.settings-focused-slider = -1; } root.settings-slider-adjusting = false; } } }
                                                    }
                                                }
                            }
                        }
                    }
                }
                }
                }
            }
        }
            HorizontalLayout {
                    x: 24px; y: parent.height - 60px; width: parent.width - 48px; height: 36px;
                    spacing: 12px;
                    Text {
                        text: root.save-message != "" ? root.save-message : root.localize("Los cambios se guardan automáticamente.", "Changes save automatically.");
                        color: Theme.muted; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap;
                    }
                    if root.import-scanning: DockButton { width: 140px; height: 36px; text: root.localize("Cancelar tareas", "Cancel tasks"); changed has-focus => { if self.has-focus { root.settings-focus-target = -2; } } clicked => { root.cancel-import(); } }
                    DockButton { width: 88px; height: 36px; text: root.localize("Cerrar", "Close"); changed has-focus => { if self.has-focus { root.settings-focus-target = -2; } } clicked => { root.back(); } }
                }
    }
    }
    if root.keyboard-visible: keyboard-overlay := Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        property <string> back-label: root.controller-type == "sony" ? "○" : root.controller-type == "nintendo" ? "A" : "B";
        property <string> confirm-label: root.controller-type == "sony" ? "×" : root.controller-type == "nintendo" ? "B" : "A";
        property <string> done-label: root.controller-type == "sony" ? "△" : root.controller-type == "nintendo" ? "X" : "Y";
        property <string> erase-label: root.controller-type == "sony"
            ? root.localize("Hombro izquierdo (L1)", "Left shoulder (L1)")
            : root.controller-type == "nintendo"
                ? root.localize("Hombro izquierdo (L)", "Left shoulder (L)")
                : root.localize("Hombro izquierdo (LB)", "Left shoulder (LB)");
        property <string> space-label: root.controller-type == "sony"
            ? root.localize("Hombro derecho (R1)", "Right shoulder (R1)")
            : root.controller-type == "nintendo"
                ? root.localize("Hombro derecho (R)", "Right shoulder (R)")
                : root.localize("Hombro derecho (RB)", "Right shoulder (RB)");
        property <string> button-hint: root.controller-type == "sony"
            ? root.localize("Cruceta: mover · ×: escribir · L1/R1: hombros (gatillos L2/R2) · △: listo · ○: cancelar", "D-pad: move · ×: type · L1/R1: shoulders (triggers L2/R2) · △: done · ○: cancel")
            : root.controller-type == "nintendo"
                ? root.localize("Cruceta: mover · B: escribir · L/R: hombros (gatillos ZL/ZR) · X: listo · A: cancelar", "D-pad: move · B: type · L/R: shoulders (triggers ZL/ZR) · X: done · A: cancel")
                : root.localize("Cruceta: mover · A: escribir · LB/RB: hombros (gatillos LT/RT) · Y: listo · B: cancelar", "D-pad: move · A: type · LB/RB: bumpers (triggers LT/RT) · Y: done · B: cancel");
        property <length> key-unit: max(18px, min(64px, (min(880px, max(0px, root.width - 32px)) - 68px) / (root.keyboard-multiline ? 12.5 : 11.5)));
        background: #00000038;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            width: min(880px, max(0px, root.width - 32px));
            height: min(max(0px, root.height - 24px), 480px);
            x: (parent.width - self.width) / 2; y: parent.height - self.height - 12px;
            background: Theme.surface; border-radius: 16px;
            border-width: 1px; border-color: Theme.text.with-alpha(0.12);
            VerticalLayout {
                padding: 16px; spacing: 6px;
                HorizontalLayout {
                    Rectangle { background: transparent; horizontal-stretch: 1; }
                    // A TouchArea keeps the native field's caret and selection.
                    Rectangle {
                        width: 140px; height: 32px; border-radius: 10px; background: Theme.button;
                        border-width: 1px; border-color: Theme.text.with-alpha(0.16);
                        accessible-role: button; accessible-label: root.localize("Cancelar", "Cancel") + " · " + keyboard-overlay.back-label;
                        accessible-action-default => { root.finish-keyboard(false); }
                        Text { x: 8px; width: parent.width - 48px; height: parent.height; text: root.localize("Cancelar", "Cancel"); color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle {
                            x: parent.width - 38px; y: 5px; width: 30px; height: 22px;
                            background: Theme.window; border-radius: 6px;
                            border-width: 1px; border-color: Theme.text.with-alpha(0.32);
                            Text { text: keyboard-overlay.back-label; color: Theme.text; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.finish-keyboard(false); } }
                    }
                }
                TextInput {
                    height: 32px; font-size: 20px; color: Theme.text;
                    text: KeyboardDraft.preview; read-only: true; enabled: false;
                    input-type: KeyboardDraft.secret ? InputType.password : InputType.text;
                }
                for keys[row] in [root.keyboard-keys-0, root.keyboard-keys-1, root.keyboard-keys-2, root.keyboard-keys-3, root.keyboard-keys-4]: HorizontalLayout {
                    spacing: 8px; vertical-stretch: 1; horizontal-stretch: 1; alignment: stretch;
                    for key[column] in keys: Rectangle {
                        horizontal-stretch: 1; vertical-stretch: 1;
                        background: root.keyboard-row == row && root.keyboard-column == column ? Theme.accent : Theme.button;
                        border-radius: 10px;
                        border-width: root.keyboard-row == row && root.keyboard-column == column ? 2px : 1px;
                        border-color: root.keyboard-row == row && root.keyboard-column == column ? Theme.accent : Theme.text.with-alpha(0.30);
                        accessible-role: button; accessible-label: key; accessible-action-default => { root.press-key(key); }
                        Text { width: parent.width; height: parent.height; text: key; color: Theme.text; font-size: 22px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.press-key(key); } }
                    }
                }
                HorizontalLayout {
                    height: 64px; spacing: 8px; vertical-stretch: 0; horizontal-stretch: 1; alignment: stretch;
                    for key[column] in [root.keyboard-uppercase ? "abc" : "ABC", root.keyboard-symbols ? "abc" : "#+=", "←", root.localize("Espacio", "Space"), "→", "⌫", root.keyboard-multiline ? "↵" : root.localize("Listo", "Done"), root.localize("Listo", "Done")]: Rectangle {
                        visible: column < 7 || root.keyboard-multiline;
                        horizontal-stretch: column == 3 ? 11 : column == 5 ? 5 : column == (root.keyboard-multiline ? 7 : 6) ? 3 : 2;
                        vertical-stretch: 1; border-radius: 10px;
                        background: root.keyboard-row == 5 && root.keyboard-column == column ? Theme.accent : column == (root.keyboard-multiline ? 7 : 6) ? Theme.accent.with-alpha(0.18) : Theme.button;
                        border-width: root.keyboard-row == 5 && root.keyboard-column == column ? 2px : 1px;
                        border-color: root.keyboard-row == 5 && root.keyboard-column == column ? Theme.accent : Theme.text.with-alpha(0.30);
                        accessible-role: button; accessible-label: key; accessible-action-default => { root.keyboard-action(column); }
                        Text {
                            y: column == 0 || column == 1 || column == 3 || column == 5 || column == (root.keyboard-multiline ? 7 : 6) ? 30px : 0px;
                            width: parent.width;
                            height: column == 0 || column == 1 || column == 3 || column == 5 || column == (root.keyboard-multiline ? 7 : 6) ? parent.height - 36px : parent.height;
                            text: key; color: Theme.text; font-size: 20px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        if column == 0 || column == 1: Rectangle {
                            x: parent.width - self.width - 6px; y: 2px; width: 28px; height: 22px;
                            background: Theme.window; border-radius: 6px; border-width: 1px; border-color: Theme.text.with-alpha(0.42);
                            Text { text: keyboard-overlay.confirm-label; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        if column == 3: Rectangle {
                            x: parent.width - self.width - 6px; y: 2px; width: min(parent.width - 8px, space-hint-label.preferred-width + 16px); height: 22px;
                            background: Theme.window; border-radius: 6px; border-width: 1px; border-color: Theme.text.with-alpha(0.42);
                            space-hint-label := Text { x: 8px; width: parent.width - 16px; height: parent.height; text: keyboard-overlay.space-label; color: Theme.text; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        }
                        if column == 5: Rectangle {
                            x: parent.width - self.width - 6px; y: 2px; width: min(parent.width - 8px, erase-hint-label.preferred-width + 16px); height: 22px;
                            background: Theme.window; border-radius: 6px; border-width: 1px; border-color: Theme.text.with-alpha(0.42);
                            erase-hint-label := Text { x: 8px; width: parent.width - 16px; height: parent.height; text: keyboard-overlay.erase-label; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                        }
                        if column == (root.keyboard-multiline ? 7 : 6): Rectangle {
                            x: parent.width - self.width - 6px; y: 2px; width: min(parent.width - 8px, 34px); height: 22px;
                            background: Theme.window; border-radius: 6px; border-width: 1px; border-color: Theme.text.with-alpha(0.42);
                            Text { text: keyboard-overlay.done-label; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.keyboard-action(column); } }
                    }
                }
                Text {
                    height: 22px; horizontal-stretch: 1; text: keyboard-overlay.button-hint;
                    color: Theme.muted; font-size: 14px; vertical-alignment: center;
                    horizontal-alignment: center; overflow: elide;
                }
            }
        }
    }
    if root.screensaver-active: Rectangle {
                x: 0px; y: 0px; width: root.width; height: root.height; background: #151515;
                Image { width: parent.width; height: parent.height; source: root.screensaver-image; image-fit: cover; }
                Rectangle { width: parent.width; height: parent.height; background: #000000; opacity: root.screensaver-dim / 100; }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.dismiss-screensaver(); } }
            }
            Rectangle {
                visible: root.launching-game;
                x: 0px; y: 0px; width: root.width; height: root.height; background: #151515;
                Image { width: parent.width; height: parent.height; source: root.launch-background; image-fit: cover; }
                Rectangle { width: parent.width; height: parent.height; background: #000000; opacity: 0.55; }
                Rectangle {
                    x: root.interpolate-length(root.launch-origin-x, (root.width - root.launch-cover-width) / 2, root.launch-eased-progress);
                    y: root.interpolate-length(root.launch-origin-y, (root.height - root.launch-cover-height) / 2 - 40px, root.launch-eased-progress);
                    width: root.interpolate-length(root.launch-origin-width, root.launch-cover-width, root.launch-eased-progress);
                    height: root.interpolate-length(root.launch-origin-height, root.launch-cover-height, root.launch-eased-progress);
                    background: root.launch-hero-visible ? transparent : Theme.accent.with-alpha(0.22);
                    border-radius: root.launch-hero-visible ? root.cover-radius * 1px : root.ring-radius * 1px;
                    border-width: root.launch-hero-visible || !root.ring-enabled ? 0px : root.ring-width * 1px;
                    border-color: root.ring-color;
                    clip: true;
                    RoundedArtwork {
                        x: root.launch-artwork-margin; y: root.launch-artwork-margin;
                        width: max(0px, parent.width - 2 * root.launch-artwork-margin);
                        height: max(0px, parent.height - 2 * root.launch-artwork-margin);
                        radius: root.games.length == 0 ? root.cover-radius * 1px : root.launch-hero-visible ? root.cover-radius * 1px : root.games[root.selected-index].list-is-logo ? 0px : root.list-artwork-radius * 1px;
                        source: root.games.length == 0 ? root.empty-image : root.launch-hero-visible ? root.selected-cover : root.games[root.selected-index].list-image;
                    }
                    if root.games.length > 0 && !root.launch-hero-visible: Rectangle {
                        x: (parent.width - self.width) / 2; y: parent.height - 6px;
                        width: min(36px, parent.width * 0.3); height: 3px; border-radius: 1.5px;
                        background: Theme.accent;
                    }
                }
                Spinner {
                    x: (parent.width - self.width) / 2;
                    y: (root.height + root.launch-cover-height) / 2 - 20px;
                    width: 30px; height: 30px;
                    indeterminate: true;
                }
                Text {
                    x: 24px; y: (root.height + root.launch-cover-height) / 2 + 26px;
                    width: root.width - 48px; height: 36px;
                    text: root.save-message; color: Theme.text; font-size: 24px;
                    horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                }
                TouchArea { width: parent.width; height: parent.height; enabled: root.launching-game; }
            }
            if root.game-session-active && !root.launching-game && !root.screensaver-active: Rectangle {
                x: 0px; y: 0px; width: root.width; height: root.height;
                background: Theme.window;
                playing-content := Rectangle {
                    x: (root.width - self.width) / 2;
                    y: (root.height - self.height) / 2;
                    width: min(500px, root.width - 64px);
                    height: self.cover-height + 64px + playing-title.height + 20px + playing-note.height;
                    background: transparent;
                    property <length> cover-height: min(360px, root.height * 0.5);
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        width: min(240px, root.width * 0.3);
                        height: playing-content.cover-height;
                        source: root.session-cover;
                        image-fit: contain;
                    }
                    Text { y: playing-content.cover-height + 20px; width: parent.width; height: 24px; text: root.localize("Jugando", "Playing"); color: Theme.muted; font-size: 18px; horizontal-alignment: center; }
                    playing-title := Text { y: playing-content.cover-height + 64px; width: parent.width; height: max(40px, self.preferred-height); text: root.session-title; color: Theme.text; font-size: 28px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                    playing-note := Text { y: playing-title.y + playing-title.height + 20px; width: parent.width; height: max(36px, self.preferred-height); text: root.localize("La biblioteca se restaurará cuando termine el juego.", "The library will return when the game ends."); color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                }
                TouchArea { width: parent.width; height: parent.height; }
            }
            TouchArea {
                z: -1;
                width: root.width; height: root.height;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { root.controller-input-active = false; root.gamepad-toolbar-focus = false; root.user-activity(); }
                    EventResult.reject
                }
            }
            if root.virtual-cursor-visible: Text {
                z: 10000;
                x: root.virtual-cursor-x;
                y: root.virtual-cursor-y;
                width: 28px; height: 32px;
                text: "↖";
                color: #ffffff;
                font-size: 30px;
                font-weight: 700;
            }
}
}
