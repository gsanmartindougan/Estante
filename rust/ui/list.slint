    callback category-changed(string);
    callback manage-category(string, string, string);
    callback letter-changed(string);
    callback ring-color-changed(string);
    callback grid-ring-color-changed(string);
    callback selection-changed(int);
    callback library-layout-changed();
    callback background-config-changed(string, int);
