                dock-quit := DockButton { width: 44px; enabled: root.library-active; text-size: 22px; text: "⏻"; label: root.localize("Salir", "Quit"); pointer-used => { root.controller-input-active = false; root.gamepad-toolbar-focus = false; } changed has-focus => { if self.has-focus && root.library-active { root.gamepad-toolbar-focus = true; root.gamepad-toolbar-index = 9; root.reveal-toolbar-control(self.x, self.width); } } clicked => { root.close-window(); } }
