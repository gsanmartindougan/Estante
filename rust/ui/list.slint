    in-out property <[string]> keyboard-keys-1: root.keyboard-symbols ? ["@", "#", "€", "$", "%", "&", "*", "+", "-", "="] : root.keyboard-uppercase ? ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"] : ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"];
    in-out property <[string]> keyboard-keys-2: root.keyboard-symbols ? ["(", ")", "[", "]", "{", "}", "<", ">", "/", "\\"] : root.keyboard-uppercase ? ["A", "S", "D", "F", "G", "H", "J", "K", "L", "Ñ"] : ["a", "s", "d", "f", "g", "h", "j", "k", "l", "ñ"];
    in-out property <[string]> keyboard-keys-3: root.keyboard-symbols ? [".", ",", ":", ";", "!", "?", "_", "~", "^", "|"] : root.keyboard-uppercase ? ["Z", "X", "C", "V", "B", "N", "M", ",", ".", "-"] : ["z", "x", "c", "v", "b", "n", "m", ",", ".", "-"];
    in-out property <[string]> keyboard-keys-4: root.keyboard-symbols ? ["'", "\"", "`", "©", "®", "™", "…", "°", "§"] : root.keyboard-uppercase ? ["Á", "É", "Í", "Ó", "Ú", "Ü", "Ñ", "¿", "¡"] : ["á", "é", "í", "ó", "ú", "ü", "ñ", "¿", "¡"];
    in property <[string]> launcher-states: ["checking", "checking", "checking"];
