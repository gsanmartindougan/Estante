    pure function artwork-field-label(field: string) -> string {
        return field == "cover" ? root.localize("Carátula vertical", "Portrait cover")
            : field == "square_cover" ? root.localize("Carátula cuadrada", "Square cover")
            : field == "logo" ? "Logo"
            : field == "banner" ? root.localize("Fondo", "Background")
            : root.localize("Fondo secundario", "Secondary background");
    }
    pure function artwork-field-value(label: string) -> string {
        return label == root.localize("Carátula vertical", "Portrait cover") ? "cover"
            : label == root.localize("Carátula cuadrada", "Square cover") ? "square_cover"
            : label == "Logo" ? "logo"
            : label == root.localize("Fondo", "Background") ? "banner"
            : "banner_secondary";
    }
    pure function artwork-provider-label(provider: string) -> string {
        return provider == "steam" ? root.localize("Capturas de Steam", "Steam screenshots")
            : provider == "igdb" ? "IGDB"
            : provider == "wikidata" ? root.localize("Ficha Wikidata", "Wikidata metadata")
            : provider == "steam-metadata" ? root.localize("Datos de Steam", "Steam metadata")
            : "SteamGridDB";
    }
    pure function artwork-provider-value(label: string) -> string {
        return label == root.localize("Capturas de Steam", "Steam screenshots") ? "steam"
            : label == "IGDB" ? "igdb"
            : label == root.localize("Ficha Wikidata", "Wikidata metadata") ? "wikidata"
            : label == root.localize("Datos de Steam", "Steam metadata") ? "steam-metadata"
            : "steamgriddb";
    }
    pure function edit-artwork-path(field: string) -> string {
        return field == "cover" ? root.edit-cover
            : field == "square_cover" ? root.edit-square-cover
            : field == "logo" ? root.edit-logo
            : field == "banner" ? root.edit-banner
            : field == "banner_secondary" ? root.edit-secondary-background
            : "";
    }

    function open-editor-artwork(field: string, metadata: bool) {
        root.artwork-field = field;
        if metadata { root.artwork-provider = "wikidata"; }
        root.showing-editor = false;
        root.showing-artwork = true;
    }
    function invalidate-artwork() {
        root.artwork-request-serial += 1;
        root.artwork-results = [];
        root.cancel-artwork-search();
        if !root.showing-artwork { root.artwork-importing = false; }
    }
    changed showing-artwork => {
        root.invalidate-artwork();
        if root.showing-artwork {
            root.artwork-navigation-target = 9;
            root.artwork-navigation-serial += 1;
            root.artwork-results-focus-index = -1;
            root.artwork-browser-focus-index = -1;
            root.artwork-browser-toolbar-focus-index = -1;
            root.text-input-focused = !root.picking-category-icon;
        }
    }
    changed artwork-browsing => {
        if root.showing-artwork {
            root.text-input-focused = !root.artwork-browsing && !root.picking-category-icon;
        }
    }
    changed artwork-provider => { root.invalidate-artwork(); }
    changed artwork-field => { root.invalidate-artwork(); }
    changed artwork-query => { root.invalidate-artwork(); }
    changed artwork-game-id => { root.invalidate-artwork(); }
    changed selected-index => { if !root.suspend-selection-updates { root.selection-changed(root.selected-index); } }
    changed games => { if !root.suspend-selection-updates { root.selection-changed(root.selected-index); } }
    changed visible-image-radius => { if !root.suspend-selection-updates { root.selection-changed(root.selected-index); } }
    changed width => { if !root.suspend-selection-updates { root.selection-changed(root.selected-index); } }
    changed height => { if !root.suspend-selection-updates { root.selection-changed(root.selected-index); } }
    changed background-width => { root.background-config-changed(root.background-split, root.blur); }
    changed background-height => { root.background-config-changed(root.background-split, root.blur); }
    changed focus-library-request => { if root.focus-library-request { root.focus-library(); root.focus-library-request = false; } }
    changed showing-activity => {
        if root.showing-activity {
            root.activity-focus-target = 0;
            root.activity-focus-serial += 1;
            root.text-input-focused = false;
        }
    }
    changed showing-editor => {
        root.editor-focus-request = root.showing-editor;
        if root.showing-editor {
            root.text-input-focused = false;
            root.editor-page = "overview";
            root.editor-focus-target = 0;
            root.editor-focus-serial += 1;
        }
    }
    changed editor-page => {
        if root.showing-editor {
            root.editor-focus-target = root.editor-page == "categories" ? root.edit-category-choices.length + 2
                : root.editor-page == "manual" ? 2
                : root.editor-page == "execution" && !root.edit-is-local ? 6
                : root.editor-page == "execution" ? 2
                : 0;
            root.editor-focus-serial += 1;
            root.text-input-focused = root.editor-page == "manual"
                || (root.editor-page == "execution" && root.edit-is-local);
        }
    }
    changed edit-is-local => {
        if root.showing-editor && root.editor-page == "execution" {
            root.editor-focus-target = root.edit-is-local ? 2 : 6;
            root.editor-focus-serial += 1;
            root.text-input-focused = root.edit-is-local;
        }
    }
    changed library-active => { if !root.library-active { root.gamepad-toolbar-focus = false; } }
    changed focus-search-request => {
        if root.focus-search-request { search_input.focus(); root.focus-search-request = false; }
    }
    function step-letter(delta: int) {
        if root.letters.length > 1 { root.letter-changed(root.letters[Math.mod(root.letter-index + delta + root.letters.length, root.letters.length)]); }
    }
    function select-previous() {
        if root.library-active && root.games.length > 0 {
            root.selected-index = root.selected-index == 0 ? root.games.length - 1 : root.selected-index - 1;
        }
    }
    function select-next() {
        if root.library-active && root.games.length > 0 {
            root.selected-index = root.selected-index + 1 >= root.games.length ? 0 : root.selected-index + 1;
        }
    }
    function grid-move(action: string) {
        if root.games.length == 0 { return; }
        let columns = grid-view.columns;
        let page-size = max(1, root.grid-page-size);
        let page-start = floor(root.selected-index / page-size) * page-size;
        let page-end = min(root.games.length, page-start + page-size);
        let page-items = page-end - page-start;
        let local-index = root.selected-index - page-start;
        let column = Math.mod(local-index, columns);
        let row = floor(local-index / columns);
        let rows = max(1, ceil(page-items / columns));
        if action == "down" && row + 1 >= rows { root.focus-dock-entry(); return; }
        if action == "left" && column > 0 { root.selected-index -= 1; }
        else if action == "right" && column + 1 < columns && local-index + 1 < page-items { root.selected-index += 1; }
        else if action == "up" && row > 0 { root.selected-index -= columns; }
        else if action == "down" && row + 1 < rows { root.selected-index = page-start + min(local-index + columns, page-items - 1); }
    }
    public function navigate-grid(action: string) { if root.library-layout == "grid" { root.grid-move(action); } }
    public function grid-page(direction: int) {
        if root.games.length > 0 { root.selected-index = min(root.games.length - 1, max(0, root.selected-index + direction * root.grid-page-size)); }
    }
    callback move-text-cursor(bool);
    public function focus-search() { search_input.focus(); }
    function save-active-work() {
        if root.showing-settings || root.picking-category-icon { root.save-settings(); }
        else if root.showing-editor || root.showing-artwork { if !root.confirming-remove { root.save-game(); } }
        else if root.showing-add-game { root.add-game(); }
    }
    public function finish-keyboard(keep: bool) { KeyboardDraft.commit = keep; root.keyboard-visible = false; }
    changed keyboard-visible => {
        if root.keyboard-visible { KeyboardDraft.commit = false; root.keyboard-uppercase = false; root.keyboard-symbols = false; root.keyboard-row = 1; root.keyboard-column = 0; }
    }
    public function keyboard-action(index: int) {
        if index == 0 { root.keyboard-uppercase = !root.keyboard-uppercase; root.keyboard-symbols = false; }
        else if index == 1 { root.keyboard-symbols = !root.keyboard-symbols; }
        else if index == 2 || index == 4 { root.move-text-cursor(index == 4); }
        else if index == 3 { root.press-key(" "); }
        else if index == 5 { root.erase-last-character(); }
        else if index == 6 && root.keyboard-multiline { root.press-key("\n"); }
        else { root.finish-keyboard(true); }
    }
    function press-key(key: string) {
        root.type-key(key);
    }

    property <bool> side-library: root.list-side == "left" || root.list-side == "right";
    property <length> body-top: 88px;
    property <length> body-height: max(200px, root.height - 192px);
    property <length> launch-hero-width: root.side-library ? min(880px, root.width * 0.65 - 48px) : min(1100px, root.width - 64px);
    property <length> launch-hero-height: root.side-library ? root.body-height : root.body-height * 0.65 - 32px;
    property <length> launch-hero-cover-width: min(260px * root.cover-zoom / 100, root.launch-hero-width * (root.side-library ? 0.65 : 0.28));
    property <length> launch-logo-width: root.side-library ? min(root.width * 0.35 * 0.72, 360px * root.list-artwork-scale / 100 * max(1, root.focus-zoom / 100)) : root.launch-logo-normal * max(1, root.focus-zoom / 100);
    property <length> launch-logo-height: root.side-library ? root.launch-logo-normal * max(1, root.focus-zoom / 100) : root.launch-logo-list-height * 0.72;
    property <length> launch-logo-list-width: root.side-library ? root.width * 0.35 : min(2200px, root.width - 40px);
    property <length> launch-logo-list-height: root.side-library ? root.body-height : max(80px, root.body-height * 0.48 - 24px);
    property <length> launch-logo-requested: (root.side-library ? 160px : 300px) * root.list-artwork-scale / 100;
    property <length> launch-logo-capacity: (root.side-library ? 160px : 300px) * root.list-artwork-scale / 100;
    property <length> launch-logo-extent: root.side-library ? root.body-height : root.launch-logo-list-width;
    property <int> launch-logo-slots: min(root.games.length, max(min(root.games.length, 7), 2 * floor(((root.launch-logo-extent - (max(1, root.focus-zoom / 100) - 1) * root.launch-logo-capacity) / (root.launch-logo-capacity + 32px) - 1) / 2) + 1));
    property <int> launch-logo-count: min(root.games.length, root.launch-logo-slots);
    property <int> launch-logo-span: max(1, root.launch-logo-count + (Math.mod(root.launch-logo-count, 2) == 0 ? 1 : 0));
    property <length> launch-logo-normal: max(1px, min(root.launch-logo-requested, (root.launch-logo-extent - 32px * root.launch-logo-span) / (root.launch-logo-span - 1 + max(1, root.focus-zoom / 100))));
    in-out property <image> selected-cover-portrait;
    in-out property <image> selected-cover-square;
    in-out property <image> selected-cover-logo;
    in-out property <image> selected-cover;
    changed cover-format => {
        root.request-settings-autosave();
        root.selected-cover = root.cover-format == "logo" && root.selected-cover-logo.width > 0
            ? root.selected-cover-logo
            : root.cover-format == "square" && root.selected-cover-square.width > 0
                ? root.selected-cover-square : root.selected-cover-portrait;
    }
    property <bool> has-selected-cover: root.games.length > 0 && (root.games[root.selected-index].cover-path != "" || root.games[root.selected-index].square-cover-path != "" || (root.cover-format == "logo" && root.games[root.selected-index].logo-path != ""));
    property <bool> launch-hero-visible: root.has-selected-cover;
    property <length> launch-origin-x: root.launch-hero-visible ? (root.side-library ? (root.list-side == "left" ? root.width * 0.35 : 0px) + (root.width * 0.65 - root.launch-hero-width) / 2 + (root.launch-hero-width - root.launch-hero-cover-width) / 2 : (root.width - root.launch-hero-width) / 2) : (root.side-library ? (root.list-side == "right" ? root.width * 0.65 : 0px) + (root.launch-logo-list-width - root.launch-logo-width) / 2 : (root.width - root.launch-logo-width) / 2);
    property <length> launch-origin-y: root.launch-hero-visible ? (root.side-library ? root.body-top : root.body-top + root.body-height * (root.list-side == "top" ? 0.35 : 0) + 16px + max(0px, (root.launch-hero-height - 514px) / 2)) : root.side-library ? root.body-top + (root.body-height - root.launch-logo-height) / 2 : root.body-top + root.body-height * (root.list-side == "top" ? 0.175 : 0.825) - root.launch-logo-height / 2;
    property <length> launch-origin-width: root.launch-hero-visible ? root.launch-hero-cover-width : root.launch-logo-width;
    property <length> launch-origin-height: root.launch-hero-visible ? (root.cover-format == "logo" && root.selected-cover.width > 0 ? min(root.side-library ? root.body-height * 0.52 : min(514px, root.launch-hero-height), root.launch-hero-cover-width * root.selected-cover.height / max(1, root.selected-cover.width) + (root.side-library ? 16px : 0px)) - (root.side-library ? 16px : 0px) : root.side-library ? min(root.body-height * 0.52, root.launch-hero-cover-width * 1.5 + 16px) - 16px : min(514px, root.launch-hero-height) - 16px) : root.launch-logo-height;
    capture-root := FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        forward-focus: keyboard;
        capture-key-pressed(event) => {
            root.user-activity();
            root.controller-input-active = false;
            root.gamepad-toolbar-focus = false;
            if root.screensaver-active { root.dismiss-screensaver(); return accept; }
            if root.game-session-active || root.launching-game { return accept; }
            if root.confirming-remove && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.remove-focus-index = event.text == Key.RightArrow ? 1 : 0;
                return accept;
            }
            if event.text == Key.Escape && !root.keyboard-visible {
                if root.picking-category-icon { root.close-artwork-browser(); }
                else { root.back(); }
                return accept;
            }
            if event.modifiers.control && event.text == "f" && root.library-active { root.focus-search(); return accept; }
            if event.modifiers.control && event.text == "s" && !root.keyboard-visible && (root.showing-settings || root.showing-editor || root.showing-activity || root.showing-artwork || root.showing-add-game) {
                root.save-active-work();
                return accept;
            }
            reject
        }
        keyboard := FocusScope {
            key-pressed(event) => {
                if root.showing-artwork && root.artwork-browsing {
                    if event.text == Key.UpArrow {
                        if root.artwork-browser-focus-index >= root.artwork-browser-columns {
                            root.artwork-browser-focus-index -= root.artwork-browser-columns;
                            root.artwork-browser-focus-serial += 1;
                        } else if root.artwork-browser-focus-index >= 0 {
                            root.artwork-browser-toolbar-focus-index = 3;
                            root.artwork-browser-toolbar-focus-serial += 1;
                        } else if root.artwork-parent-folder != "" {
                            root.browse-artwork-folder(root.artwork-parent-folder);
                        } else {
                            root.close-artwork-browser();
                        }
                        return accept;
                    }
                    if event.text == Key.DownArrow && root.artwork-browser-toolbar-focus-index == 3 {
                        root.artwork-browser-toolbar-focus-index = -1;
                        root.artwork-browser-focus-index = max(0, root.artwork-browser-focus-index);
                        root.artwork-browser-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.DownArrow && root.artwork-browser-toolbar-focus-index >= 0 {
                        root.artwork-browser-toolbar-focus-index = -1;
                        root.artwork-browser-focus-index = max(0, root.artwork-browser-focus-index);
                        root.artwork-browser-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.DownArrow && (root.artwork-browser-focus-index + root.artwork-browser-columns < root.artwork-browser-item-count || (Math.floor(root.artwork-browser-focus-index / root.artwork-browser-columns) + 1) * root.artwork-browser-columns < root.artwork-browser-item-count) {
                        root.artwork-browser-focus-index = min(root.artwork-browser-focus-index + root.artwork-browser-columns, root.artwork-browser-item-count - 1);
                        root.artwork-browser-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.LeftArrow && Math.mod(root.artwork-browser-focus-index, root.artwork-browser-columns) > 0 {
                        root.artwork-browser-focus-index -= 1;
                        root.artwork-browser-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.RightArrow && Math.mod(root.artwork-browser-focus-index, root.artwork-browser-columns) < root.artwork-browser-columns - 1 && root.artwork-browser-focus-index + 1 < root.artwork-browser-item-count {
                        root.artwork-browser-focus-index += 1;
                        root.artwork-browser-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.LeftArrow && root.artwork-browser-focus-index >= 0 && Math.mod(root.artwork-browser-focus-index, root.artwork-browser-columns) == 0 {
                        root.artwork-browser-toolbar-focus-index = 0;
                        root.artwork-browser-toolbar-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.RightArrow && root.artwork-browser-focus-index >= 0 && (Math.mod(root.artwork-browser-focus-index, root.artwork-browser-columns) == root.artwork-browser-columns - 1 || root.artwork-browser-focus-index + 1 >= root.artwork-browser-item-count) {
                        root.artwork-browser-toolbar-focus-index = 5;
                        root.artwork-browser-toolbar-focus-serial += 1;
                        return accept;
                    }
                }
                if root.showing-artwork && !root.artwork-browsing && root.artwork-results-focus-index >= 0 {
                    if event.text == Key.UpArrow && root.artwork-results-focus-index < root.artwork-result-columns {
                        root.artwork-results-focus-index = -1;
                        root.artwork-query-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.UpArrow {
                        root.artwork-results-focus-index -= root.artwork-result-columns;
                        root.artwork-results-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        root.artwork-results-focus-index = min(root.artwork-results-focus-index + root.artwork-result-columns, root.artwork-results.length - 1);
                        root.artwork-results-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.LeftArrow {
                        root.artwork-results-focus-index = max(root.artwork-results-focus-index - 1, 0);
                        root.artwork-results-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.RightArrow {
                        root.artwork-results-focus-index = min(root.artwork-results-focus-index + 1, root.artwork-results.length - 1);
                        root.artwork-results-focus-serial += 1;
                        return accept;
                    }
                    if event.text == Key.Return {
                        root.choose-artwork(root.artwork-results-focus-index);
                        return accept;
                    }
                }
                if root.showing-artwork && !root.artwork-browsing && event.text == Key.DownArrow && root.artwork-results-focus-index < 0 && root.artwork-results.length > 0 {
                    root.artwork-results-focus-index = 0;
                    root.artwork-results-focus-serial += 1;
                    return accept;
                }
                if event.text == Key.Escape { root.back(); return accept; }
                if !root.library-active { return reject; }
                if root.library-layout == "grid" && (event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    root.grid-move(event.text == Key.LeftArrow ? "left" : event.text == Key.RightArrow ? "right" : event.text == Key.UpArrow ? "up" : "down");
                    return accept;
                }
                if event.text == Key.LeftArrow { root.select-previous(); return accept; }
                if event.text == Key.RightArrow { root.select-next(); return accept; }
                if event.text == Key.Return { root.play-selected(); return accept; }
                reject
            }
        }
    Rectangle {
        width: root.width; height: root.height;
        background: Theme.window;
        Image { width: parent.width; height: parent.height; source: root.selected-background-image; image-fit: cover; }
        Rectangle { width: parent.width; height: parent.height; background: #000; opacity: root.selected-background-image.width > 0 ? (root.library-layout == "grid" ? root.grid-dim : root.dim) / 100 : 0; }
        Rectangle { width: parent.width; height: parent.height; background: @linear-gradient(180deg, #00000061 0%, #0000002e 45%, #000000e6 100%); }
        LogoPath {
            visible: root.library-layout != "grid";
            x: root.list-side == "right" ? root.width * 0.65 : root.side-library ? 0px : (root.width - self.width) / 2;
            y: root.side-library ? root.body-top : root.body-top + root.body-height * (root.list-side == "top" ? 0.175 : 0.825) - self.height / 2;
            width: root.side-library ? root.width * 0.35 : min(2200px, root.width - 40px);
            height: root.side-library ? root.body-height : max(80px, root.body-height * 0.48 - 24px);
            games: root.games; visible-game-indices: root.visible-game-indices; selected-index: root.selected-index; side: root.list-side;
            accessible-name: root.localize("Lista de juegos", "Game list");
