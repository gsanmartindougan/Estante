            HorizontalLayout {
                spacing: 4px; padding-top: 10px; padding-bottom: 10px;
                dock-play := DockButton { width: 100px; text: root.localize("Jugar", "Play"); icon: root.controller-input-active ? root.button-icon("play") : root.empty-image; icon-size: 28px; enabled: root.library-active && root.games.length > 0 && !root.game-session-active; pointer-used => { root.controller-input-active = false; root.gamepad-toolbar-focus = false; } changed has-focus => { if self.has-focus { root.gamepad-toolbar-focus = true; root.gamepad-toolbar-index = 0; root.reveal-toolbar-control(self.x, self.width); } } clicked => { root.play-selected(); } }
                dock-edit := DockButton { width: 100px; text: root.localize("Editar", "Edit"); icon: root.controller-input-active ? root.button-icon("edit") : root.empty-image; icon-size: 28px; enabled: root.library-active && root.games.length > 0 && !root.game-session-active && !root.import-scanning; pointer-used => { root.controller-input-active = false; root.gamepad-toolbar-focus = false; } changed has-focus => { if self.has-focus { root.gamepad-toolbar-focus = true; root.gamepad-toolbar-index = 1; root.reveal-toolbar-control(self.x, self.width); } } clicked => { root.begin-edit(); } }
                dock-back := DockButton { enabled: root.library-active; width: 100px; text: root.localize("Volver", "Back"); icon: root.controller-input-active ? root.button-icon("back") : root.empty-image; icon-size: 28px; pointer-used => { root.controller-input-active = false; root.gamepad-toolbar-focus = false; } changed has-focus => { if self.has-focus { root.gamepad-toolbar-focus = true; root.gamepad-toolbar-index = 2; root.reveal-toolbar-control(self.x, self.width); } } clicked => { if root.search-query != "" { root.search-query = ""; root.search-changed(""); } else { root.focus-library-request = true; } } }
                dock-settings := DockButton { enabled: root.library-active; width: 108px; text: root.localize("Ajustes", "Settings"); icon: root.controller-input-active ? root.button-icon("menu") : root.empty-image; icon-size: 28px; pointer-used => { root.controller-input-active = false; root.gamepad-toolbar-focus = false; } changed has-focus => { if self.has-focus { root.gamepad-toolbar-focus = true; root.gamepad-toolbar-index = 3; root.reveal-toolbar-control(self.x, self.width); } } clicked => { root.settings-section = 0; root.showing-settings = true; } }
                Rectangle { horizontal-stretch: 1; }
