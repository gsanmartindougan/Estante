                y: root.library-layout == "grid" ? 0px : root.side-library ? (hero.cover-width == 0px ? 0px : (hero.height - (hero.cover-height + 32px)) / 2 + hero.cover-height + 48px) : (hero.height - min(500px, hero.height)) / 2;
                width: root.library-layout == "grid" || root.side-library || hero.cover-width == 0px ? hero.detail-pane-width : max(0px, parent.width - self.x - 32px);
                height: root.library-layout == "grid" ? min(500px, parent.height) : root.side-library ? max(1px, min(420px, info.preferred-height + 48px, hero.height - self.y)) : min(500px, parent.height);
                background: Theme.surface.with-alpha(0.9); border-radius: 14px; border-width: 1px; border-color: Theme.text.with-alpha(0.08);
                info-scroll := ScrollView {
                    x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    info := VerticalLayout {
                        alignment: start; spacing: 18px;
                        if root.library-layout != "grid": Text { text: root.games.length > 0 ? root.games[root.selected-index].title : root.localize("Tu próxima aventura empieza aquí", "Your next adventure starts here"); color: Theme.text; font-size: root.width < 1100px ? 32px : 46px; font-weight: 700; wrap: word-wrap; line-height-factor: 1.1; }
                        if root.games.length > 0 && root.games[root.selected-index].activity != "": Text { text: root.games[root.selected-index].activity; color: Theme.muted; font-size: 15px; wrap: word-wrap; }
                        if root.games.length > 0: Text { text: root.games[root.selected-index].description != "" ? root.games[root.selected-index].description : root.localize("Sin sinopsis disponible.", "No synopsis available."); color: Theme.muted; font-size: 15px; wrap: word-wrap; line-height-factor: 1.35; }
                        if root.games.length > 0: FlexboxLayout {
                            horizontal-stretch: 1; spacing: 8px; alignment: start; cross-axis-alignment: center;
                            for genre in root.games[root.selected-index].genre-tags: Rectangle {
                                width: label.preferred-width + 24px; height: 30px; background: Theme.button; border-radius: 8px;
                                label := Text { x: 12px; width: parent.width - 24px; height: parent.height; text: genre; color: Theme.text; font-size: 15px; vertical-alignment: center; }
                            }
                        }
                        if root.games.length > 0: Text {
                            text: root.games[root.selected-index].details + (root.library-layout == "grid" ? (root.grid-launcher-details ? (root.games[root.selected-index].details == "" ? "" : "\n") + root.games[root.selected-index].launcher + "\n" + root.games[root.selected-index].path : "") : (root.launcher-details ? (root.games[root.selected-index].details == "" ? "" : "\n") + root.games[root.selected-index].launcher + "\n" + root.games[root.selected-index].path : ""));
                            visible: self.text != "";
                            color: Theme.muted; font-size: 15px; wrap: word-wrap; line-height-factor: 1.3;
                        }
                    }
                }
            }
        }
    }
    // Keep every action reachable when the window is narrower than the toolbar.
    Rectangle {
        x: (root.width - self.width) / 2; y: root.height - 78px;
        width: min(root.width - 32px, root.toolbar-natural-width + 104px); height: 64px;
        background: #0000002e; border-radius: 14px;
    }
    Rectangle {
        x: (root.width - self.width) / 2; y: root.height - 80px;
