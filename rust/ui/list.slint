                height: root.cover-format == "logo" ? hero.logo-frame-height : hero.cover-height + 32px;
                background: Theme.surface.with-alpha(0.48);
                border-radius: root.cover-format == "logo" ? 24px : root.cover-radius * 1px + 16px;
                border-width: 1px; border-color: Theme.text.with-alpha(0.18);
                drop-shadow-color: #00000090;
                drop-shadow-blur: 26px;
                drop-shadow-offset-y: 10px;
                RoundedArtwork {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
