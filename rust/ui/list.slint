    // shortcut: this width mirrors the fixed toolbar items; update it when buttons change.
    private property <length> toolbar-natural-width:
        408px + (root.width >= 1200px ? 74px : 0px) + search_input.width
        + (root.width < 1000px ? 128px : 164px)
        + root.launcher-names.length * 18px + 132px
        + (11 + root.launcher-names.length) * 4px;
    callback operate-launcher(int);
    pure function launcher-status(state: string) -> string {
        return state == "open" ? root.localize("Abierto", "Open") : state == "closed" ? root.localize("Cerrado", "Closed") : state == "opening" ? root.localize("Abriendo…", "Opening…") : state == "closing" ? root.localize("Cerrando…", "Closing…") : state == "timeout" ? root.localize("Tiempo de espera agotado", "Timed out") : state == "error" ? root.localize("Error", "Error") : root.localize("Comprobando…", "Checking…");
    }


