import { Palette, CheckBox, LineEdit, ListView, ScrollView, Slider, Spinner, TextEdit } from "std-widgets.slint";

export struct GameRow {
    source-index: int,
    id: string,
    title: string,
    launcher: string,
    path: string,
    arguments: string,
    cwd: string,
    subtitle: string,
    categories: string,
    description: string,
    synopsis: string,
    genre-tags: [string],
    release-date: string,
    developers: string,
    publishers: string,
    genres: string,
    platforms: string,
    metadata-source: string,
    metadata-entity-id: string,
    steam-appid: string,
    activity: string,
    activity-history: string,
    details: string,
    cover-image: image,
    square-cover-image: image,
    list-image: image,
    cover-path: string,
    square-cover-path: string,
    logo-path: string,
    list-is-logo: bool,
    banner-path: string,
    secondary-background-path: string,
}

export struct EditCategory {
    name: string,
    checked: bool,
}

export struct CategoryMember {
    id: string,
    title: string,
    checked: bool,
}

export struct ArtworkRow {
    name: string,
    preview: image,
    game-choice: bool,
}

export struct ArtworkBrowserItem {
    name: string,
    path: string,
    directory: bool,
    preview: image,
    preview-loaded: bool,
    preview-requested: bool,
}

export struct ArtworkBrowserRow {
    items: [ArtworkBrowserItem],
}

export global Theme {
    in-out property <bool> pastel: true;
    in-out property <string> color-theme: "default";
    private property <color> primary-swatch: root.color-theme == "combination-176" ? #ffb3f0 : #0d75ff;
    private property <color> secondary-swatch: root.color-theme == "combination-176" ? #ffcfc4 : #b875eb;
    private property <color> tertiary-swatch: root.color-theme == "combination-176" ? #80ffcc : #9cb29e;
    out property <bool> dark: Palette.background.red * 0.2126 + Palette.background.green * 0.7152 + Palette.background.blue * 0.0722 < 127.5;
    out property <float> hue: Palette.accent-background.to-hsv().hue;
    out property <brush> window: Palette.background;
    out property <brush> text: Palette.foreground;
    out property <brush> muted: Palette.foreground.with-alpha(0.72);
    out property <brush> accent: root.color-theme == "default" ? Palette.accent-background : root.primary-swatch;
    out property <brush> accent-foreground: root.color-theme == "default" ? Palette.accent-foreground : root.relative-luminance(root.primary-swatch) > 0.179 ? #000000 : #ffffff;
    out property <brush> base: root.color-theme == "default" ? (root.pastel ? root.hsl(root.hue - 5.4, 0.18, root.dark ? 0.10 : 0.97) : Palette.alternate-background) : root.tertiary-swatch.with-alpha(0.10);
    out property <brush> surface: root.color-theme == "default" ? (root.pastel ? root.hsl(root.hue + 12.6, 0.18, root.dark ? 0.15 : 0.92) : Palette.background) : root.hsl(root.secondary-swatch.to-hsv().hue, 0.14, root.dark ? 0.15 : 0.92);
    out property <brush> button: root.color-theme == "default" ? (root.pastel ? root.hsl(root.hue, 0.34, root.dark ? 0.24 : 0.84) : Palette.control-background) : root.hsl(root.secondary-swatch.to-hsv().hue, 0.45, root.dark ? 0.26 : 0.84);
    pure function linear-channel(channel: float) -> float {
        let value = channel / 255;
        return value <= 0.04045 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);
    }
    pure function relative-luminance(value: color) -> float {
        return 0.2126 * root.linear-channel(value.red) + 0.7152 * root.linear-channel(value.green) + 0.0722 * root.linear-channel(value.blue);
    }
    pure function hsl(h: float, s: float, l: float) -> color {
        let v = l + s * min(l, 1 - l);
        return hsv(Math.mod(h + 360, 360), v == 0 ? 0 : 2 * (1 - l / v), v);
    }
}

component RoundedArtwork inherits Rectangle {
    in property <image> source;
    in property <length> radius;
    in property <color> colorize: transparent;
    in property <bool> expose-accessible-image: true;
    property <float> aspect: root.source.width / max(1, root.source.height);
    Rectangle {
        width: min(root.width, root.height * root.aspect);
        height: min(root.height, root.width / max(0.0001, root.aspect));
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: root.radius;
        clip: true;
        if root.expose-accessible-image: Image {
            width: parent.width; height: parent.height; source: root.source; image-fit: contain; colorize: root.colorize;
        }
        if !root.expose-accessible-image: Image {
            width: parent.width; height: parent.height; source: root.source; image-fit: contain;
            colorize: root.colorize;
            accessible-role: none;
        }
    }
}

component LogoPath inherits Rectangle {
    in property <[GameRow]> games;
    in property <[int]> visible-game-indices;
    in property <string> accessible-name;
    in property <int> selected-index;
    in property <string> side;
    in property <int> zoom;
    in property <int> focus-zoom;
    in property <bool> ring-enabled;
    in property <color> ring-color;
    in property <int> ring-width;
    in property <int> ring-radius;
    in property <int> cover-radius;
    callback selected(int);
    callback visible-radius-changed(int);
    callback pointer-used();
    property <bool> vertical: root.side == "left" || root.side == "right";
    property <float> focus-scale: max(1, root.focus-zoom / 100);
    property <length> extent: root.vertical ? root.height : root.width;
    property <length> gap: 32px;
    property <length> requested: (root.vertical ? 180px : 340px) * root.zoom / 100;
    property <length> capacity-requested: (root.vertical ? 160px : 300px) * root.zoom / 100;
    property <int> slots: min(root.games.length, max(min(root.games.length, 7), 2 * floor(((root.extent - (root.focus-scale - 1) * root.capacity-requested) / (root.capacity-requested + root.gap) - 1) / 2) + 1));
    property <int> count: min(root.games.length, root.slots);
    changed count => { root.visible-radius-changed(floor(root.count / 2)); }
    property <int> span: max(1, root.count + (Math.mod(root.count, 2) == 0 ? 1 : 0));
    property <bool> focused-cover-in-side: root.vertical && root.games.length > 0 && !root.games[root.selected-index].list-is-logo;
    property <length> horizontal-reference-height: root.vertical ? max(80px, root.extent * 0.48 - 24px) : root.height;
    property <length> selected-cover-extent: max(1px, min(max(1px, root.horizontal-reference-height - 16px), root.horizontal-reference-height * 0.72));
    property <length> normal: root.focused-cover-in-side
        ? max(1px, min(root.requested, (root.extent - root.gap * root.span - root.selected-cover-extent) / max(1, root.span - 1)))
        : max(1px, min(root.requested, (root.extent - root.gap * root.span) / (root.span - 1 + root.focus-scale)));
    property <length> selected-extent: root.focused-cover-in-side ? root.selected-cover-extent : root.normal * root.focus-scale;
    property <length> neighbour: (root.selected-extent + root.normal) / 2 + root.gap;
    property <length> half-span: (root.normal * (root.span - 1) + root.selected-extent + root.gap * root.span) / 2;
    property <length> selected-width: root.vertical ? min(root.width * 0.72, 360px * root.zoom / 100 * root.focus-scale) : root.selected-extent;
    property <length> selected-height: root.vertical ? root.selected-extent : max(1px, min(max(1px, root.height - 16px), root.height * 0.72));
    property <length> bend: max(0px, min((root.vertical ? root.width - root.selected-width : root.height - root.selected-height) / 2 - 8px, root.normal * 0.6));
    property <length> edge: (root.side == "right" || root.side == "bottom" ? 1 : -1) * root.bend;
    property <float> drag-progress: 0;
    property <int> image-radius: min(floor(root.games.length / 2), floor(root.count / 2) + floor(abs(root.drag-progress)));
    clip: true;
    background: transparent;
    accessible-role: list;
    accessible-label: root.accessible-name;
    accessible-item-count: root.games.length;
    changed image-radius => { root.visible-radius-changed(root.image-radius); }
    pure function distance(index: int) -> int {
        return Math.mod(index - root.selected-index + root.games.length + floor(root.games.length / 2), max(1, root.games.length)) - floor(root.games.length / 2);
    }
    pure function path-distance(index: int) -> float {
        let delta = root.distance(index) - root.drag-progress;
        return delta - floor((delta + root.games.length / 2) / max(1, root.games.length)) * max(1, root.games.length);
    }
    pure function path-offset(distance: float) -> length {
        let magnitude = abs(distance);
        return (distance < 0 ? -1 : 1) * (magnitude <= 1 ? magnitude * root.neighbour : root.neighbour + (magnitude - 1) * (root.normal + root.gap));
    }
    for game[index] in root.games: Rectangle {
        x: 0px; y: 0px; width: 1px; height: 1px;
        background: transparent;
        accessible-role: list-item;
        accessible-label: game.title;
        accessible-item-index: index;
        accessible-item-selectable: true;
        accessible-item-selected: index == root.selected-index;
        accessible-action-default => { root.selected(index); }
    }
    for index in root.visible-game-indices: Rectangle {
        property <GameRow> game: root.games[index];
        property <int> distance: root.distance(index);
        property <float> path-distance: root.path-distance(index);
        property <bool> in-range: abs(self.path-distance) <= floor(root.count / 2);
        visible: self.in-range;
        property <bool> selected: self.distance == 0;
        property <length> offset: root.path-offset(self.path-distance);
        property <length> cross: root.edge * (self.offset / root.half-span) * (self.offset / root.half-span);
        width: root.selected-width / (self.selected ? 1 : root.focus-scale);
        height: root.vertical && root.focused-cover-in-side
            ? (self.selected ? root.selected-height : root.normal)
            : root.selected-height / (self.selected ? 1 : root.focus-scale);
        x: root.width / 2 + (root.vertical ? self.cross : self.offset) - self.width / 2;
        y: root.height / 2 + (root.vertical ? self.offset : self.cross) - self.height / 2;
        background: transparent;
        border-radius: root.ring-radius * 1px;
        border-width: 0px;
        animate x, y, width, height { duration: 130ms; easing: ease-in-out; }
        animate background { duration: 150ms; }
        property <length> margin: max(8px, self.border-width + 2px);
        if self.in-range && self.selected && !game.list-is-logo: Rectangle {
            property <length> available-width: max(0px, parent.width - 2 * parent.margin);
            property <length> available-height: max(0px, parent.height - 2 * parent.margin);
            property <length> image-width: min(self.available-width, self.available-height * game.list-image.width / max(1, game.list-image.height));
            property <length> image-height: min(self.available-height, self.available-width * game.list-image.height / max(1, game.list-image.width));
            x: parent.margin + (self.available-width - self.image-width) / 2;
            y: parent.margin + (self.available-height - self.image-height) / 2;
            width: self.image-width; height: self.image-height;
            border-radius: root.cover-radius * 1px;
            background: Theme.accent;
            opacity: 0.30;
            drop-shadow-color: Theme.accent;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 7px;
        }
        if self.in-range: RoundedArtwork {
            x: parent.margin; y: parent.margin;
            width: max(0px, parent.width - 2 * parent.margin);
            height: max(0px, parent.height - 2 * parent.margin);
            radius: game.list-is-logo ? 0px : root.cover-radius * 1px;
            expose-accessible-image: false;
            source: game.list-image;
            opacity: index == root.selected-index ? 1 : 0.65;
            animate opacity { duration: 150ms; }
        }
        if self.in-range && self.selected: Rectangle {
            x: (parent.width - self.width) / 2; y: parent.height - 6px;
            width: min(36px, parent.width * 0.3); height: 3px; border-radius: 1.5px;
            background: Theme.accent;
        }
        accessible-role: none;
    }
    input := TouchArea {
        property <int> start-index;
        property <bool> dragged;
        property <bool> suppress-click;
        property <length> scroll-remainder;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.pointer-used(); self.start-index = root.selected-index; self.dragged = false; self.suppress-click = false; root.drag-progress = 0; }
            if event.kind == PointerEventKind.up && self.dragged {
                root.selected(Math.mod(self.start-index + round(root.drag-progress) + root.games.length * 1000, root.games.length));
                root.drag-progress = 0;
                self.dragged = false;
                self.suppress-click = true;
            }
            if event.kind == PointerEventKind.cancel { root.drag-progress = 0; self.dragged = false; }
        }
        moved => {
            let delta = root.vertical ? self.mouse-y - self.pressed-y : self.mouse-x - self.pressed-x;
            if self.pressed && abs(delta) > 8px { self.dragged = true; }
            if self.pressed && self.dragged && root.games.length > 0 {
                root.drag-progress = -delta / root.neighbour;
            }
        }
        clicked => {
            if self.suppress-click { self.suppress-click = false; }
            else if !self.dragged && root.games.length > 0 {
                let axis = (root.vertical ? self.mouse-y : self.mouse-x) - root.extent / 2;
                let distance = abs(axis) < root.selected-extent / 2 + root.gap / 2 ? 0 : (axis < 0px ? -1 : 1) * (1 + round((abs(axis) - root.neighbour) / (root.normal + root.gap)));
                root.selected(Math.mod(root.selected-index + distance + root.games.length, root.games.length));
            }
        }
        scroll-event(event) => {
            self.scroll-remainder += abs(event.delta-y) > abs(event.delta-x) ? event.delta-y : event.delta-x;
            if abs(self.scroll-remainder) >= 24px && root.games.length > 0 {
                root.selected(Math.mod(root.selected-index + (self.scroll-remainder < 0px ? 1 : -1) + root.games.length, root.games.length));
                self.scroll-remainder = 0px;
            }
            accept
        }
    }
}

component DockButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <length> icon-size: 28px;
    in property <length> text-size: 13px;
    in property <string> trailing-text;
    in property <string> previous-letter;
    in property <string> next-letter;
    in property <string> corner-shortcut;
    in property <bool> shortcut-right: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> plain: false;
    in property <bool> checkable: false;
    in property <bool> checked: false;
    in property <length> button-radius: 10px;
    in property <length> content-padding: 12px;
    in property <brush> foreground: root.primary ? Theme.accent-foreground : root.danger ? (Theme.dark ? #ffecee : #762d35) : Theme.text;
    in property <bool> enabled: true;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();
    callback pointer-used();
    forward-focus: focus-scope;
    height: 44px;
    background: transparent;
    border-width: 0px;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        x: 0px; y: 0px;
        width: root.width;
        height: root.height;
        border-radius: root.button-radius;
        border-width: root.plain ? (root.has-focus ? 2px : 0px) : (root.has-focus ? 2px : 1px);
        border-color: root.has-focus || root.checked || root.primary ? Theme.accent : root.danger ? #b6535d : Theme.text.with-alpha(0.22);
        background: root.plain ? transparent : root.primary ? Theme.accent : root.danger ? (Theme.dark ? #63363b : #f4dfe1) : root.checked ? Theme.accent.with-alpha(0.2) : Theme.text.with-alpha(touch.pressed ? 0.16 : root.has-focus ? 0.12 : touch.has-hover ? 0.09 : 0.06);
    }
    if root.corner-shortcut != "": Rectangle {
        x: root.shortcut-right ? root.width - self.width - 3px : 3px;
        y: 2px; width: 24px; height: 15px;
        background: Theme.surface.with-alpha(0.96);
        border-radius: 4px; border-width: 1px; border-color: Theme.text.with-alpha(0.28);
        Text {
            width: parent.width; height: parent.height;
            text: root.corner-shortcut; color: Theme.text; font-size: 9px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    HorizontalLayout {
        y: root.corner-shortcut == "" ? 0px : 8px;
        height: root.corner-shortcut == "" ? root.height : root.height - 8px;
        alignment: root.trailing-text == "" ? LayoutAlignment.center : LayoutAlignment.stretch;
        spacing: 8px;
        padding-left: root.trailing-text == "" ? root.content-padding : 16px;
        padding-right: root.trailing-text == "" ? root.content-padding : 16px;
        if root.icon.width > 0: Image { width: root.icon-size; source: root.icon; image-fit: contain; }
        if root.previous-letter != "": Text { text: root.previous-letter; font-size: 11px; color: root.foreground; opacity: 0.56; vertical-alignment: center; }
        Text { text: root.text; font-size: root.text-size; font-weight: 600; color: root.foreground; vertical-alignment: center; overflow: elide; }
        if root.next-letter != "": Text { text: root.next-letter; font-size: 11px; color: root.foreground; opacity: 0.56; vertical-alignment: center; }
        if root.trailing-text != "": Text { width: 12px; text: root.trailing-text; color: root.foreground; vertical-alignment: center; horizontal-alignment: right; }
    }
    focus-scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        changed has-hover => { if self.has-hover { root.pointer-used(); } }
        clicked => { root.pointer-used(); focus-scope.focus(); root.clicked(); }
    }
}

component RadioOption inherits DockButton {
    in property <string> option-label;
    in property <bool> selected;
    in property <int> editor-focus-index: -1;
    in property <int> editor-focus-target: -1;
    in property <int> editor-focus-serial;
    in property <bool> navigation-active: false;
    callback chosen();
    callback focus-selected(int);
    callback focus-changed(bool);
    public function focus-control() { self.focus(); }
    text: (root.selected ? "● " : "○ ") + root.option-label;
    label: root.option-label;
    accessible-role: radio-button;
    accessible-label: root.option-label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    plain: true;
    checked: root.selected;
    foreground: root.selected ? Theme.accent : Theme.text;
    button-radius: 8px;
    content-padding: 6px;
    text-size: 14px;
    height: 36px;
    clicked => { root.chosen(); }
    init => { if root.navigation-active && root.editor-focus-target == root.editor-focus-index && root.selected { self.focus(); } }
    changed editor-focus-target => { if root.navigation-active && root.editor-focus-target == root.editor-focus-index && root.selected { self.focus(); } }
    changed editor-focus-serial => { if root.navigation-active && root.editor-focus-target == root.editor-focus-index && root.selected { self.focus(); } }
    changed navigation-active => { if root.navigation-active && root.editor-focus-target == root.editor-focus-index && root.selected { self.focus(); } }
    changed has-focus => {
        root.focus-changed(self.has-focus);
        if self.has-focus && root.navigation-active { root.focus-selected(root.editor-focus-index); }
    }
}

component RadioOptions inherits GridLayout {
    in property <[string]> options: [];
    in property <int> selected-index: 0;
    in property <bool> horizontal: false;
    in property <int> editor-focus-index: -1;
    in property <int> editor-focus-target: -1;
    in property <int> editor-focus-serial;
    in property <bool> navigation-active: false;
    callback selected(string, int);
    callback focus-selected(int);
    accessible-role: radio-group;
    spacing: root.horizontal ? 12px : 2px;
    for option[index] in root.options: RadioOption {
        row: root.horizontal ? 0 : index;
        col: root.horizontal ? index : 0;
        option-label: option;
        selected: index == root.selected-index;
        horizontal-stretch: root.horizontal ? 0 : 1;
        editor-focus-index: root.editor-focus-index;
        editor-focus-target: root.editor-focus-target;
        editor-focus-serial: root.editor-focus-serial;
        navigation-active: root.navigation-active;
        chosen => { root.selected(option, index); }
        focus-selected(index) => { root.focus-selected(index); }
    }
}

component EditorNavButton inherits DockButton {
    in property <int> editor-focus-index;
    in property <int> editor-focus-target;
    in property <int> editor-focus-serial;
    in property <bool> navigation-active;
    in property <bool> focus-on-serial: false;
    callback focus-selected(int);
    init => { if root.focus-on-serial || (root.navigation-active && root.editor-focus-target == root.editor-focus-index) { self.focus(); } }
    changed focus-on-serial => { if root.focus-on-serial { self.focus(); } }
    changed editor-focus-target => { if root.navigation-active && root.editor-focus-target == root.editor-focus-index { self.focus(); } }
    changed editor-focus-serial => { if root.focus-on-serial || (root.navigation-active && root.editor-focus-target == root.editor-focus-index) { self.focus(); } }
    changed has-focus => { if self.has-focus { root.focus-selected(root.editor-focus-index); } }
}

component EditorNavCheckBox inherits CheckBox {
    in property <int> editor-focus-index;
    in property <int> editor-focus-target;
    in property <int> editor-focus-serial;
    in property <bool> navigation-active;
    callback focus-selected(int);
    init => { if root.navigation-active && root.editor-focus-target == root.editor-focus-index { self.focus(); } }
    changed editor-focus-target => { if root.navigation-active && root.editor-focus-target == root.editor-focus-index { self.focus(); } }
    changed editor-focus-serial => { if root.navigation-active && root.editor-focus-target == root.editor-focus-index { self.focus(); } }
    changed has-focus => { if self.has-focus && root.navigation-active { root.focus-selected(root.editor-focus-index); } }
}

global KeyboardDraft {
    in-out property <bool> visible;
    in-out property <bool> commit;
    in-out property <string> preview;
    in-out property <bool> multiline;
    in-out property <bool> secret;
}

component LibraryField inherits LineEdit {
    in-out property <string> model-text;
    in property <bool> focus-on-request: false;
    in property <int> navigation-focus-index: -1;
    in property <int> navigation-focus-target: -1;
    in property <int> navigation-focus-serial;
    in property <bool> navigation-active: false;
    callback updated(string);
    callback focus-selected(int);
    accessible-label: root.placeholder-text;
    private property <bool> keyboard-open: KeyboardDraft.visible;
    private property <bool> editing-draft;
    changed focus-on-request => { if root.focus-on-request { root.focus(); } }
    changed navigation-focus-target => { if root.navigation-active && root.navigation-focus-target == root.navigation-focus-index { root.focus(); } }
    changed navigation-focus-serial => { if root.navigation-active && root.navigation-focus-target == root.navigation-focus-index { root.focus(); } }
    changed has-focus => { if self.has-focus && root.navigation-active { root.focus-selected(root.navigation-focus-index); } }
    init => { root.text = root.model-text; if root.focus-on-request { root.focus(); } }
    changed model-text => { if !root.editing-draft && root.text != root.model-text { root.text = root.model-text; } }
    changed keyboard-open => {
        if root.keyboard-open && root.has-focus {
            root.editing-draft = true;
            KeyboardDraft.preview = root.text;
            KeyboardDraft.secret = root.input-type == InputType.password;
            KeyboardDraft.multiline = false;
        } else if !root.keyboard-open && root.editing-draft {
            root.editing-draft = false;
            if KeyboardDraft.commit {
                root.model-text = root.text;
                root.updated(root.text);
            } else { root.text = root.model-text; }
            KeyboardDraft.preview = "";
        }
    }
    edited(value) => {
        if root.editing-draft { KeyboardDraft.preview = value; }
        else { root.model-text = value; root.updated(value); }
    }
    key-pressed(event) => {
        if root.editing-draft && (event.text == Key.Escape || event.text == Key.Tab || (event.text == Key.Return && !KeyboardDraft.multiline) || (event.modifiers.control && event.text == "s")) {
            if event.text != Key.Tab {
                KeyboardDraft.commit = event.text != Key.Escape;
                KeyboardDraft.visible = false;
            }
            return accept;
        }
        reject
    }
}

component LibraryTextArea inherits TextEdit {
    in-out property <string> model-text;
    in property <int> navigation-focus-index: -1;
    in property <int> navigation-focus-target: -1;
    in property <int> navigation-focus-serial;
    in property <bool> navigation-active: false;
    callback updated(string);
    callback focus-selected(int);
    private property <bool> keyboard-open: KeyboardDraft.visible;
    private property <bool> editing-draft;
    changed navigation-focus-target => { if root.navigation-active && root.navigation-focus-target == root.navigation-focus-index { root.focus(); } }
    changed navigation-focus-serial => { if root.navigation-active && root.navigation-focus-target == root.navigation-focus-index { root.focus(); } }
    changed has-focus => { if self.has-focus && root.navigation-active { root.focus-selected(root.navigation-focus-index); } }
    init => { root.text = root.model-text; }
    changed model-text => { if !root.editing-draft && root.text != root.model-text { root.text = root.model-text; } }
    changed keyboard-open => {
        if root.keyboard-open && root.has-focus {
            root.editing-draft = true;
            KeyboardDraft.preview = root.text;
            KeyboardDraft.secret = false;
            KeyboardDraft.multiline = true;
        } else if !root.keyboard-open && root.editing-draft {
            root.editing-draft = false;
            if KeyboardDraft.commit {
                root.model-text = root.text;
                root.updated(root.text);
            } else { root.text = root.model-text; }
            KeyboardDraft.preview = "";
        }
    }
    edited(value) => {
        if root.editing-draft { KeyboardDraft.preview = value; }
        else { root.model-text = value; root.updated(value); }
    }
    key-pressed(event) => {
        if root.editing-draft && (event.text == Key.Escape || event.text == Key.Tab || (event.text == Key.Return && !KeyboardDraft.multiline) || (event.modifiers.control && event.text == "s")) {
            if event.text != Key.Tab {
                KeyboardDraft.commit = event.text != Key.Escape;
                KeyboardDraft.visible = false;
            }
            return accept;
        }
        reject
    }
}

component SettingCheck inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    out property <bool> has-focus: focus-scope.has-focus;
    callback focus-changed(bool);
    public function focus-control() { focus-scope.focus(); }
    function toggle() { root.checked = !root.checked; }
    forward-focus: focus-scope;
    height: 44px;
    background: Theme.button;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggle(); }
    Rectangle {
        x: 4px; y: (parent.height - 26px) / 2;
        width: 26px; height: 26px; border-radius: 6px;
        background: root.checked ? Theme.accent : Theme.surface;
        border-width: 2px;
        border-color: root.checked ? Theme.accent : Theme.text;
        if root.checked: Text {
            text: "✓"; color: Theme.window; font-size: 21px; font-weight: 700;
            width: parent.width; height: parent.height;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    Text {
        x: 42px; y: 0px; width: max(0px, root.width - 42px); height: root.height;
        text: root.text; color: Theme.text; font-size: 14px; vertical-alignment: center; wrap: word-wrap;
    }
    if self.has-focus: Rectangle {
        x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;
        background: transparent; border-radius: 8px; border-width: 2px; border-color: Theme.accent;
    }
    focus-scope := FocusScope {
        width: parent.width; height: parent.height;
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.toggle(); return accept; }
            reject
        }
        changed has-focus => { root.focus-changed(self.has-focus); }
    }
    TouchArea { clicked => { focus-scope.focus(); root.toggle(); } }
}

component SettingGroup inherits Rectangle {
    in property <string> title;
    in property <bool> flat: false;
    in property <int> navigation-column: -1;
    in property <int> navigation-index: -1;
    in property <bool> navigation-enabled: false;
    in property <int> navigation-target: -1;
    in property <length> navigation-focus-y: 0px;
    in property <bool> navigation-focus-children: true;
    in-out property <bool> expanded;
    callback spatial-navigation(int, length, string);
    callback spatial-position-changed(int, length);
    callback spatial-focus-requested(int, length);
    callback header-focus-changed(int, bool, length);
    out property <length> content-origin-y: root.expanded ? (root.flat ? 36px : 60px) : 0px;
    public function focus-header() { heading.focus(); }
    height: root.expanded ? group-layout.preferred-height : (root.flat ? 42px : 64px);
    clip: true;
    background: root.flat ? transparent : Theme.button;
    border-color: root.flat ? transparent : Theme.text.with-alpha(0.1);
    border-width: root.flat ? 0px : 1px;
    border-radius: root.flat ? 0px : 16px;
    init => { root.spatial-position-changed(root.navigation-index, root.y); }
    changed y => { root.spatial-position-changed(root.navigation-index, root.y); }
    changed navigation-target => {
        if root.navigation-target == root.navigation-index {
            if root.expanded && root.navigation-focus-children { root.spatial-focus-requested(root.navigation-index, root.navigation-focus-y); }
            else { heading.focus(); }
        }
    }
    navigation-scope := FocusScope {
        width: parent.width; height: parent.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.navigation-enabled && root.navigation-column >= 0 && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.spatial-navigation(root.navigation-column, root.navigation-focus-y, event.text == Key.LeftArrow ? "left" : "right");
                return accept;
            }
            reject
        }
        group-layout := VerticalLayout {
            padding: root.flat ? 0px : 14px; spacing: root.flat ? 6px : 10px; alignment: start;
            heading := DockButton {
                text: root.title;
                trailing-text: root.expanded ? "⌄" : "›";
                text-size: root.flat ? 15px : 18px;
                height: root.flat ? 30px : 36px;
                plain: true;
                background: self.has-focus ? Theme.text : transparent;
                foreground: self.has-focus ? Theme.window : Theme.text;
                border-radius: 10px;
                changed has-focus => { root.header-focus-changed(root.navigation-index, self.has-focus, root.y + 32px); }
                clicked => { root.expanded = !root.expanded; }
            }
            VerticalLayout {
                visible: root.expanded; spacing: 10px;
                @children
            }
        }
    }
}

component SettingStepper inherits VerticalLayout {
    in property <string> label;
    in property <int> minimum;
    in property <int> maximum;
    in-out property <int> number;
    in property <int> step: max(1, round((root.maximum - root.minimum) / 50));
    callback focus-changed(bool);
    out property <length> focus-center-y: stepper-scope.y + stepper-scope.height / 2;
    out property <bool> has-focus: decrease-button.has-focus || increase-button.has-focus;
    public function focus-control() { decrease-button.focus(); }
    spacing: 8px;
    Text { text: root.label; color: Theme.text; wrap: word-wrap; }
    stepper-scope := FocusScope {
        horizontal-stretch: 1;
        height: 44px;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.number = max(root.minimum, root.number - root.step);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.number = min(root.maximum, root.number + root.step);
                return accept;
            }
            reject
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            height: parent.height;
            spacing: 8px;
            decrease-button := DockButton {
                width: 48px; height: 44px; text: "←"; text-size: 20px; content-padding: 4px;
                label: root.label + " decrease";
                enabled: root.number > root.minimum;
                clicked => { root.number = max(root.minimum, root.number - root.step); }
                changed has-focus => { root.focus-changed(self.has-focus); }
            }
            Text {
                horizontal-stretch: 1;
                text: root.number;
                color: root.has-focus ? Theme.accent : Theme.text;
                font-size: 16px; font-weight: root.has-focus ? 700 : 500;
                horizontal-alignment: center; vertical-alignment: center;
            }
            increase-button := DockButton {
                width: 48px; height: 44px; text: "→"; text-size: 20px; content-padding: 4px;
                label: root.label + " increase";
                enabled: root.number < root.maximum;
                clicked => { root.number = min(root.maximum, root.number + root.step); }
                changed has-focus => { root.focus-changed(self.has-focus); }
            }
        }
    }
}

component BackgroundChoice inherits Rectangle {
    in property <string> label;
    in property <image> preview;
    in property <bool> selected;
    callback chosen();
    width: 160px;
    height: self.width * 9 / 16 + 36px;
    background: Theme.button;
    border-radius: 8px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.text.with-alpha(0.12);
    Image { x: 4px; y: 4px; width: parent.width - 8px; height: (parent.width - 8px) * 9 / 16; source: root.preview; image-fit: cover; }
    Text { x: 4px; y: 8px + (parent.width - 8px) * 9 / 16; width: parent.width - 8px; height: 22px; text: root.label; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }
    TouchArea { clicked => { root.chosen(); } }
}

component CoverGrid inherits Rectangle {
    in property <[GameRow]> games;
    in property <int> selected-index;
    in property <int> items-per-page: 10;
    in property <int> zoom: 100;
    in property <bool> square-covers;
    in property <string> previous-page-label;
    in property <string> next-page-label;
    in property <string> previous-page-shortcut;
    in property <string> next-page-shortcut;
    in property <int> cover-radius: 12;
    in property <bool> ring-enabled: true;
    in property <color> ring-color: #ffffff;
    in property <int> ring-width: 3;
    in property <int> ring-radius: 18;
    callback selected(int);
    property <int> layout-items: max(1, min(root.page-size, root.games.length - root.page-start));
    property <length> pagination-bottom-inset: 32px;
    property <length> grid-content-height: max(1px, root.height - 100px);
    property <int> target-columns: min(root.layout-items, max(1, ceil(Math.sqrt(root.layout-items * (root.square-covers ? 1.1 : 1.55) * root.width / root.grid-content-height))));
    property <int> target-rows: max(1, ceil(root.layout-items / root.target-columns));
    property <length> cell-width: min(root.width, max(140px, min(312px, 216px * root.zoom / 100, root.width / root.target-columns, root.grid-content-height / (root.target-rows * (root.square-covers ? 1.1 : 1.55)))));
    out property <int> columns: max(1, floor(root.width / root.cell-width));
    property <length> cell-height: root.cell-width * (root.square-covers ? 1.1 : 1.55);
    property <int> page-size: max(1, root.items-per-page);
    property <int> page-count: max(1, floor((root.games.length + root.page-size - 1) / root.page-size));
    property <int> page-index: floor(root.selected-index / root.page-size);
    property <int> page-start: root.page-index * root.page-size;
    property <int> page-rows: max(1, floor((min(root.games.length, root.page-start + root.page-size) - root.page-start + root.columns - 1) / root.columns));
    property <int> visible-rows: max(1, floor(root.grid-content-height / root.cell-height));
    property <int> scroll-row: max(0, min(root.page-rows - root.visible-rows, floor((root.selected-index - root.page-start) / root.columns) - root.visible-rows + 1));
    property <length> grid-left: max(0px, (root.width - root.columns * root.cell-width) / 2);
    clip: true;
    for game[index] in root.games: Rectangle {
        property <int> local-index: index - root.page-index * root.page-size;
        property <int> row-index: floor(self.local-index / root.columns);
        visible: self.local-index >= 0 && self.local-index < root.page-size && self.row-index >= root.scroll-row && self.row-index < root.scroll-row + root.visible-rows;
        x: root.grid-left + Math.mod(self.local-index, root.columns) * root.cell-width;
        y: (self.row-index - root.scroll-row) * root.cell-height;
        width: root.cell-width;
        height: root.cell-height;
        background: transparent;
        Rectangle {
            x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
            background: Theme.surface.with-alpha(0.86);
            border-radius: index == root.selected-index && root.ring-enabled ? root.ring-radius * 1px : root.cover-radius * 1px;
            border-width: index == root.selected-index ? (root.ring-enabled ? root.ring-width * 1px : 0px) : 1px;
            border-color: index == root.selected-index && root.ring-enabled ? root.ring-color : Theme.text.with-alpha(0.18);
            RoundedArtwork {
                x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                radius: root.cover-radius * 1px;
                source: root.square-covers && game.square-cover-image.width > 0 ? game.square-cover-image : game.cover-image;
            }
        }
        TouchArea { clicked => { root.selected(index); } }
        accessible-role: list-item;
        accessible-label: game.title;
        accessible-item-index: index;
        accessible-item-selected: index == root.selected-index;
        accessible-action-default => { root.selected(index); }
    }
    Rectangle {
        x: (root.width - self.width) / 2;
        y: max(0px, root.height - self.height - root.pagination-bottom-inset);
        width: 196px; height: 52px;
        background: Theme.surface.with-alpha(0.94);
        border-radius: 12px; border-width: 1px; border-color: Theme.text.with-alpha(0.18);
        HorizontalLayout {
            x: 6px; y: 4px; width: parent.width - 12px; height: parent.height - 8px;
            spacing: 4px;
            DockButton { width: 48px; text: "‹"; label: root.previous-page-label + " · " + root.previous-page-shortcut; corner-shortcut: root.previous-page-shortcut; enabled: root.page-index > 0; clicked => { root.selected(max(0, root.selected-index - root.page-size)); } }
            Text { horizontal-stretch: 1; text: root.games.length > 0 ? (root.page-index + 1) + " / " + root.page-count : "0 / 0"; color: Theme.text; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            DockButton { width: 48px; text: "›"; label: root.next-page-label + " · " + root.next-page-shortcut; corner-shortcut: root.next-page-shortcut; shortcut-right: true; enabled: root.page-index + 1 < root.page-count; clicked => { root.selected(min(root.games.length - 1, root.selected-index + root.page-size)); } }
        }
    }
}

export component ListWindow inherits Window {
    forward-focus: capture-root;
    title: "Estante · Slint";
    preferred-width: 1180px;
    preferred-height: 760px;
    background: Theme.window;
    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;

    in-out property <[GameRow]> games: [];
    in-out property <string> library-layout: "list";
    in-out property <int> grid-page-size: 10;
    in-out property <int> grid-zoom: 100;
    in-out property <bool> grid-minimal: false;
    in-out property <int> grid-dim: 50;
    in-out property <int> grid-blur: 0;
    in-out property <string> grid-hero-position: "full";
    in-out property <string> grid-background-split: "single";
    in-out property <string> grid-cover-format: "portrait";
    in-out property <int> grid-cover-radius: 12;
    in-out property <bool> grid-launcher-details: true;
    in-out property <bool> grid-ring-enabled: true;
    in-out property <string> grid-ring-color-text: "#ffffff";
    in-out property <color> grid-ring-color: #ffffff;
    in-out property <int> grid-ring-width: 3;
    in-out property <int> grid-ring-radius: 18;
    in property <[int]> visible-game-indices: [];
    in-out property <image> empty-image;
    in-out property <image> selected-background-image;
    out property <int> background-width: max(1, round(root.width / 1px));
    out property <int> background-height: max(1, round(root.height / 1px));
    in property <[image]> category-icons;
    in-out property <[string]> categories: [];
    in-out property <[string]> letters: [];
    in-out property <int> category-index: 0;
    in-out property <int> letter-index: 0;
    in-out property <int> selected-index: 0;
    in-out property <int> visible-image-radius: 0;
    in-out property <bool> suspend-selection-updates: false;
    in-out property <bool> showing-settings: false;
    in-out property <length> virtual-cursor-x: 0px;
    in-out property <length> virtual-cursor-y: 0px;
    in-out property <bool> virtual-cursor-visible: false;
    in-out property <bool> settings-restoring: false;
    in-out property <int> settings-section: 0;
    private property <int> settings-sidebar-focus-request: 0;
    private property <int> settings-content-focus-request: 0;
    out property <bool> settings-slider-focused: root.settings-focused-slider >= 0;
    private property <int> settings-focused-slider: -1;
    in-out property <bool> settings-slider-adjusting: false;
    out property <bool> combo-popup-open: false;
    in-out property <length> settings-focus-y: 0px;
    out property <int> settings-focus-target: -1;
    out property <bool> settings-sidebar-focused: false;
    private property <length> settings-row-y-0: 0px;
    private property <length> settings-row-y-1: 0px;
    private property <length> settings-row-y-2: 0px;
    private property <length> settings-row-y-3: 0px;
    private property <length> settings-row-y-4: 0px;
    private property <length> settings-row-y-5: 0px;
    private property <length> settings-row-y-6: 0px;
    private property <length> settings-row-y-7: 0px;
    private property <length> settings-row-y-8: 0px;
    private property <length> settings-row-y-9: 0px;
    private property <length> settings-row-y-10: 0px;
    changed showing-settings => {
        if !root.showing-settings {
            root.settings-focus-target = -1;
            root.settings-focused-slider = -1;
            root.settings-slider-adjusting = false;
        }
    }
    changed settings-section => {
        root.settings-focus-target = -1;
        root.settings-focused-slider = -1;
    }
    in-out property <int> category-edit-index: 1;
    in-out property <string> primary-category;
    in-out property <string> member-query;
    in property <[CategoryMember]> category-members;
    in-out property <string> icon-path;
    in-out property <string> icon-query;
    in-out property <string> icon-provider: "bootstrap";
    in-out property <bool> icon-busy;
    in-out property <bool> picking-category-icon;
    in-out property <[string]> icon-results;
    out property <string> managed-category: root.category-edit-index > 0 && root.category-edit-index < root.categories.length ? root.categories[root.category-edit-index] : "";
    callback refresh-members();
    callback search-icons();
    callback choose-icon(int);
    changed managed-category => { root.confirming-category-delete = false; root.refresh-members(); }
    changed member-query => { root.refresh-members(); }
    changed icon-query => { root.icon-results = []; }
    changed icon-provider => { root.icon-results = []; }
    public function close-artwork-browser() {
        root.artwork-browsing = false;
        if root.picking-category-icon {
            root.picking-category-icon = false;
            root.showing-artwork = false;
            root.showing-settings = true;
        }
    }

    in-out property <string> category-name: "";
    in-out property <bool> confirming-category-delete: false;
    in-out property <bool> showing-editor: false;
    in-out property <string> editor-page: "overview";
    in-out property <int> editor-focus-serial;
    in-out property <int> editor-focus-target: 0;
    in-out property <int> activity-focus-serial;
    in-out property <int> activity-focus-target: 0;
    in-out property <int> artwork-navigation-serial;
    in-out property <int> artwork-navigation-target: 9;
    in-out property <bool> showing-add-game: false;
    in-out property <bool> confirming-remove: false;
    in-out property <bool> import-scanning: false;
    in-out property <bool> game-session-active: false;
    in-out property <bool> launching-game: false;
    in property <image> launch-background;
    property <length> launch-cover-width: min(300px, root.width * 0.35);
    property <length> launch-cover-height: root.cover-format == "square" ? root.launch-cover-width : root.cover-format == "logo" && root.selected-cover.width > 0 ? root.launch-cover-width * root.selected-cover.height / max(1, root.selected-cover.width) : root.launch-cover-width * 1.5;
    property <float> launch-linear-progress: root.launching-game ? 1 : 0;
    out property <float> launch-eased-progress: root.ease-in-out-cubic(root.launch-linear-progress);
    animate launch-linear-progress { duration: root.launching-game ? 280ms : 0ms; easing: linear; }
    pure function ease-in-out-cubic(progress: float) -> float {
        progress < 0.5
            ? 4.0 * progress * progress * progress
            : 1.0 - (2.0 - 2.0 * progress) * (2.0 - 2.0 * progress) * (2.0 - 2.0 * progress) / 2.0
    }
    pure function interpolate-length(from: length, to: length, progress: float) -> length {
        from + (to - from) * progress
    }
    property <length> launch-artwork-margin: root.launch-hero-visible ? 0px : max(8px, (root.ring-enabled ? root.ring-width * 1px : 0px) + 2px);
    in-out property <bool> showing-activity: false;
    in-out property <bool> showing-artwork: false;
    in-out property <bool> screensaver-active: false;
    in-out property <image> screensaver-image;
    in-out property <int> screensaver-dim: 35;
    in-out property <string> playing-behavior: "none";
    in-out property <bool> screensaver-enabled: false;
    in-out property <int> screensaver-idle-value: 5;
    in-out property <string> screensaver-idle-unit: "minutes";
    in-out property <int> screensaver-slide-value: 15;
    in-out property <string> screensaver-slide-unit: "seconds";
    in-out property <string> screensaver-source: "games";
    in-out property <string> screensaver-background: "bundled:6.png";
    in-out property <bool> show-session-history: true;
    in-out property <bool> start-steam-on-start: false;
    in-out property <bool> start-fullscreen: true;
    in-out property <bool> start-faugus-on-start: false;
    in-out property <bool> start-heroic-on-start: false;
    in-out property <bool> close-steam-on-exit: false;
    in-out property <bool> close-faugus-on-exit: false;
    in-out property <bool> close-heroic-on-exit: false;
    in-out property <string> controller-type: "xbox";
    in-out property <string> onscreen-keyboard: "auto";
    in-out property <string> language: "system";
