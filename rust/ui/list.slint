                    previous-letter: root.letters.length > 0 ? root.letters[Math.mod(root.letter-index + root.letters.length - 1, root.letters.length)] : "";
                    next-letter: root.letters.length > 0 ? root.letters[Math.mod(root.letter-index + 1, root.letters.length)] : "";
                    pointer-used => { root.controller-input-active = false; root.gamepad-toolbar-focus = false; }
                    clicked => { root.step-letter(1); }
