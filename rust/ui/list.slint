            width: root.library-layout == "grid" ? max(1px, root.width * 0.26 - 40px) : root.width;
            height: root.library-layout == "grid" ? max(1px, root.body-height - 128px) : root.side-library ? root.body-height : root.body-height * 0.65 - 32px;
            background: transparent;
            property <length> detail-pane-width: root.library-layout == "grid" ? self.width - 16px : root.side-library ? min(880px, root.width * 0.65 - 48px) : min(1100px, root.width - 64px);
            property <length> detail-pane-x: root.library-layout == "grid" ? 8px : root.side-library ? (root.list-side == "left" ? root.width * 0.35 : 0px) + (root.width * 0.65 - self.detail-pane-width) / 2 : (root.width - self.detail-pane-width) / 2;
            property <length> logo-frame-width: min(640px, max(64px, self.detail-pane-width - 32px));
            property <length> logo-frame-height: min(190px, max(64px, self.height - 32px));
            property <length> logo-cover-width: min(560px * root.cover-zoom / 100, max(1px, self.detail-pane-width - 64px));
            property <length> cover-width: root.library-layout != "grid" && root.has-selected-cover && root.show-detail-cover ? (root.cover-format == "logo" ? self.logo-cover-width : min(260px * root.cover-zoom / 100, self.detail-pane-width * (root.side-library ? 0.65 : 0.28))) : 0px;
            property <length> cover-height: self.cover-width == 0px ? 16px : root.cover-format == "logo" ? self.logo-frame-height - 32px : root.side-library ? min(root.body-height * 0.52, self.cover-width * 1.5 + 16px) : min(514px, self.height);
            Rectangle {
                visible: root.library-layout != "grid" && root.show-detail-cover && root.has-selected-cover;
